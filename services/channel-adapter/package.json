    "test:integrity": "node ../../tools/qa/validate-targets.mjs --cwd . src/channels/meta/meta.adapter.test.js src/channels/meta/meta.sender.test.js src/channels/webchat/webchat.adapter.test.js src/channels/whatsapp-qr/whatsapp-qr.adapter.test.js src/runtime/inbound-turn-coalescer.test.js src/runtime/pending-utterance-assembler.test.js src/normalization/unified-message.test.js",
