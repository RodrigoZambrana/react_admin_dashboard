{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-harness.intake.schema.json",
  "title": "AI Harness intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "request",
    "need",
    "statements",
    "requirements",
    "slices",
    "fidelity"
  ],
  "properties": {
    "schema": { "const": "ai-harness.intake/v1" },
    "id": { "type": "string", "minLength": 1 },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "body"],
      "properties": {
        "source": { "enum": ["prompt", "document", "conversation"] },
        "title": { "type": "string" },
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "need": { "type": "string", "minLength": 1 },
    "statements": {
      "type": "array",
      "items": { "$ref": "#/$defs/statement" }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slice" }
    },
    "scopeChanges": {
      "type": "array",
      "items": { "$ref": "#/$defs/scopeChange" }
    },
    "inferredAnswers": {
      "type": "array",
      "maxItems": 0
    },
    "alternateBacklog": { "not": {} },
    "tasks": { "not": {} },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewedAgainstSource"],
      "properties": {
        "reviewedAgainstSource": { "const": true },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["fact", "assumption", "question"] },
        "text": { "type": "string", "minLength": 1 },
        "sourceSpan": { "type": "string" },
        "requirementId": { "type": "string" },
        "answeredBy": { "enum": ["human", "none"] },
        "answer": { "type": "string" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "material", "product"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "material": { "type": "boolean" },
        "product": { "type": "string", "minLength": 1 },
        "cluster": { "type": "string" },
        "sourceSpan": { "type": "string" },
        "statementIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "result", "scope", "product", "gate", "requirementIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["in", "out"],
          "properties": {
            "in": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "out": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "product": { "type": "string", "minLength": 1 },
        "gate": { "type": "string", "minLength": 1 },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string" }
        },
        "backlogTaskId": { "type": "string" },
        "sharedTransaction": { "type": "boolean" }
      }
    },
    "scopeChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary"],
      "properties": {
        "kind": { "enum": ["decision", "supersession"] },
        "summary": { "type": "string", "minLength": 1 },
        "decisionRef": { "type": "string", "pattern": "^DEC-[0-9]{3}$" }
      }
    }
  }
}
