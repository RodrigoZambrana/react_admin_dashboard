{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-harness.lifecycle-close-receipt.schema.json",
  "title": "AI Harness lifecycle close receipt v2",
  "type": "object",
  "required": [
    "schema",
    "sessionId",
    "backlogTaskId",
    "status",
    "startedAt",
    "preparedAt",
    "closedAt",
    "summary",
    "task",
    "git",
    "evidence",
    "decisionRefs",
    "productChanges"
  ],
  "properties": {
    "schema": { "const": "ai-harness.lifecycle-close-receipt/v2" },
    "sessionId": { "type": "string", "minLength": 1 },
    "backlogTaskId": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{3}$" },
    "status": { "const": "done" },
    "startedAt": { "type": "string", "format": "date-time" },
    "preparedAt": { "type": "string", "format": "date-time" },
    "closedAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 1 },
    "task": { "type": "object" },
    "git": {
      "type": "object",
      "required": ["branch", "baseCommit", "headAtClose", "worktree", "linkedWorktree", "preexistingChanges", "diff", "commit"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "headAtClose": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "worktree": { "type": "string", "minLength": 1 },
        "linkedWorktree": { "type": "boolean" },
        "preexistingChanges": { "type": "array" },
        "diff": {
          "type": "object",
          "required": ["baseCommit", "head", "branch", "changedPaths", "ownedPaths", "preservedPreexistingPaths", "nameStatus", "workingTree", "candidateFingerprint"]
        },
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "mode", "parent", "branch", "message", "sessionTrailer", "paths", "manifest", "manifestExcludes"],
          "properties": {
            "required": { "const": true },
            "mode": { "const": "isolated-local" },
            "parent": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "branch": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "sessionTrailer": { "type": "string", "pattern": "^AI-Harness-Session: .+" },
            "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "manifest": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "state", "sha256"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "state": { "enum": ["present", "deleted"] },
                  "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
                }
              }
            },
            "manifestExcludes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "evidence": { "type": "object" },
    "decisionRefs": { "type": "array", "items": { "type": "string" } },
    "productChanges": { "type": "boolean" }
  }
}
