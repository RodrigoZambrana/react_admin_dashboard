{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Growth Platform Backlog",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "tasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "title", "product", "type", "phase", "priority", "status",
          "objective", "rationale", "scope", "dependencies",
          "acceptanceCriteria", "verification", "risks", "decisionsRequired",
          "decisionRefs", "size", "sourceRefs"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{3}$" },
          "status": { "enum": ["proposed", "ready", "blocked", "in_progress", "done", "deferred"] },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "size": { "enum": ["S", "M", "L", "XL"] },
          "scope": {
            "type": "object",
            "required": ["in", "out"],
            "properties": {
              "in": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "out": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "acceptanceCriteria": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "verification": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "risks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "decisionsRequired": { "type": "array", "items": { "type": "string" } },
          "decisionRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
