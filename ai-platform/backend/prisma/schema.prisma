generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ManagedResourceStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum KnowledgeCategory {
  GENERAL
  FAQ
  PRODUCT
  BOOKING
  QUOTE
  POLICY
}

enum AsyncConversationTurnStatus {
  STABILIZING
  PROCESSING
  AWAITING_REPLY
  COMPLETED
  SUPERSEDED
  FAILED
}

enum DocumentOriginKind {
  TEXT
  UPLOAD
  URL
}

enum DocumentIngestionStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum DocumentKnowledgeItemKind {
  ENTITY
  CLAIM
}

enum DocumentKnowledgeSupportClass {
  EXPLICIT_FACT
  PARTIAL_FACT
  BOUNDED_INFERENCE
}

enum DocumentKnowledgeEvidenceTier {
  TYPED_CLAIM
  NORMALIZED_PROPOSITION
  EXCERPT_ONLY
}

enum DocumentKnowledgePolarity {
  AFFIRMED
  NEGATED
  CONDITIONAL
  COMPARATIVE
  UNKNOWN
}

enum DocumentKnowledgePromotionState {
  UNCLASSIFIED
  CANDIDATE
  PROMOTED
  REJECTED
}

enum DocumentExtractionProfileConfigSource {
  TENANT_DERIVED
}

enum CatalogSourceKind {
  UPLOADED_STRUCTURED
  REST
}

enum CatalogSyncStatus {
  PENDING
  SYNCING
  READY
  FAILED
}

enum TestCenterScenarioSourceKind {
  CURATED
  DERIVED
}

enum TestCenterEvaluationStatus {
  PASS
  WARN
  FAIL
}

model Conversation {
  id          String    @id @default(cuid())
  tenantId    String
  language    String?
  channel     String    @default("web")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]
  logs        ChatLog[]
  state       ConversationState?
  asyncTurns  AsyncConversationTurn[]
  testCenterEvaluation TestCenterConversationEvaluation?

  @@index([tenantId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  tenantId       String
  conversationId String
  role           MessageRole
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
}

model ChatLog {
  id             String        @id @default(cuid())
  tenantId       String
  conversationId String?
  traceId        String
  stage          String
  status         String
  payload        Json
  latencyMs      Int?
  createdAt      DateTime      @default(now())
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, traceId, createdAt])
}

model ConversationState {
  id                String       @id @default(cuid())
  tenantId          String
  conversationId    String       @unique
  lane              String
  lastIntent        String?
  lastApprovedAction String?
  lastApprovedToolName String?
  approvedFacts     Json?
  pendingFacts      Json?
  missingFields     String[]     @default([])
  nextUsefulField   String?
  lastApprovedResult Json?
  metadata          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, lane, updatedAt])
}

model PromptVersion {
  id          String       @id @default(cuid())
  tenantId    String
  key         String
  version     Int
  status      ManagedResourceStatus @default(DRAFT)
  template    String
  metadata    Json?
  createdAt   DateTime     @default(now())
  createdBy   String?

  @@unique([tenantId, key, version])
  @@index([tenantId, key, status])
}

model TemporalLocaleVersion {
  id        String                @id @default(cuid())
  tenantId  String
  locale    String
  version   Int
  status    ManagedResourceStatus @default(DRAFT)
  resource  Json
  metadata  Json?
  createdAt DateTime              @default(now())
  createdBy String?

  @@unique([tenantId, locale, version])
  @@index([tenantId, locale, status])
}

model CriticalConfigVersion {
  id        String                @id @default(cuid())
  tenantId  String
  key       String
  version   Int
  status    ManagedResourceStatus @default(DRAFT)
  value     Json
  metadata  Json?
  createdAt DateTime              @default(now())
  createdBy String?

  @@unique([tenantId, key, version])
  @@index([tenantId, key, status])
}

model KnowledgeMetadataVersion {
  id        String                @id @default(cuid())
  tenantId  String
  key       String
  version   Int
  status    ManagedResourceStatus @default(DRAFT)
  resource  Json
  metadata  Json?
  createdAt DateTime              @default(now())
  createdBy String?

  @@unique([tenantId, key, version])
  @@index([tenantId, key, status])
}

model ResponseFallbackVersion {
  id        String                @id @default(cuid())
  tenantId  String
  locale    String
  version   Int
  status    ManagedResourceStatus @default(DRAFT)
  resource  Json
  metadata  Json?
  createdAt DateTime              @default(now())
  createdBy String?

  @@unique([tenantId, locale, version])
  @@index([tenantId, locale, status])
}

model Knowledge {
  id          String            @id @default(cuid())
  tenantId    String
  sourceLogId String?
  category    KnowledgeCategory
  title       String
  body        String
  summary     String
  tags        String[]
  confidence  Float
  embeddingId String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([tenantId, category, createdAt])
}

model DocumentRecord {
  id              String                  @id @default(cuid())
  tenantId        String
  title           String
  status          ManagedResourceStatus   @default(DRAFT)
  ingestionStatus DocumentIngestionStatus @default(PENDING)
  originKind      DocumentOriginKind
  sourceName      String?
  mimeType        String?
  language        String?
  sourceText      String
  summary         String?
  chunkCount      Int                     @default(0)
  lastIngestedAt  DateTime?
  lastError       String?
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  chunks          DocumentChunk[]
  knowledgeItems  DocumentKnowledgeItem[]
  propositions    DocumentKnowledgeProposition[]
  extractionProfileConfigs DocumentExtractionProfileConfigRecord[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, ingestionStatus, createdAt])
}

model DocumentExtractionProfileConfigRecord {
  id         String                               @id @default(cuid())
  tenantId   String
  documentId String
  profileId  String
  locale     String
  sourceKind DocumentExtractionProfileConfigSource @default(TENANT_DERIVED)
  hints      Json
  metadata   Json?
  createdAt  DateTime                             @default(now())
  updatedAt  DateTime                             @updatedAt
  document   DocumentRecord                       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, profileId, locale])
  @@index([tenantId, profileId, locale, updatedAt])
  @@index([tenantId, documentId, updatedAt])
}

model DocumentChunk {
  id         String         @id @default(cuid())
  tenantId   String
  documentId String
  sequence   Int
  content    String
  searchText String
  retrievalProjection String?
  metadata   Json?
  createdAt  DateTime       @default(now())
  document   DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeItems DocumentKnowledgeItem[]
  propositions DocumentKnowledgeProposition[]

  @@unique([documentId, sequence])
  @@index([tenantId, documentId, sequence])
}

model DocumentKnowledgeItem {
  id             String                       @id @default(cuid())
  tenantId       String
  documentId     String
  chunkId        String
  sequence       Int
  kind           DocumentKnowledgeItemKind
  label          String
  valueText      String
  normalizedValue String?
  supportClass   DocumentKnowledgeSupportClass
  evidenceTextSpan String
  metadata       Json?
  createdAt      DateTime                     @default(now())
  document       DocumentRecord               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk          DocumentChunk                @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId, chunkId, sequence])
  @@index([tenantId, kind, label])
}

model DocumentKnowledgeProposition {
  id                String                         @id @default(cuid())
  tenantId          String
  documentId        String
  chunkId           String
  sequence          Int
  layer             String?
  extractionScope   String?
  profileKey        String?
  subjectAxis       String?
  subjectValue      String?
  subjectNormalized String?
  predicate         String
  facet             String?
  objectValue       String
  objectNormalized  String?
  polarity          DocumentKnowledgePolarity
  supportClass      DocumentKnowledgeSupportClass
  evidenceTier      DocumentKnowledgeEvidenceTier @default(NORMALIZED_PROPOSITION)
  confidence        Float
  relationScope     Json?
  canonicalKey      String
  patternKey        String
  evidenceTextSpan  String
  metadata          Json?
  promotionState    DocumentKnowledgePromotionState @default(UNCLASSIFIED)
  promotedAxis      String?
  promotedFacet     String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  document          DocumentRecord                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk             DocumentChunk                  @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId, chunkId, sequence])
  @@index([tenantId, predicate, facet])
  @@index([tenantId, patternKey])
  @@index([tenantId, promotionState, updatedAt])
}

model CatalogSourceRecord {
  id           String              @id @default(cuid())
  tenantId     String
  title        String
  kind         CatalogSourceKind
  status       ManagedResourceStatus @default(DRAFT)
  syncStatus   CatalogSyncStatus   @default(PENDING)
  sourceName   String?
  mimeType     String?
  endpointUrl  String?
  sourceConfig Json?
  metadata     Json?
  itemCount    Int                 @default(0)
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        CatalogItemRecord[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, kind, status, createdAt])
}

model CatalogItemRecord {
  id           String            @id @default(cuid())
  tenantId     String
  sourceId     String
  externalId   String?
  sku          String?
  name         String
  description  String?
  price        Float?
  currency     String?
  availability String?
  attributes   Json?
  searchText   String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  source       CatalogSourceRecord @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId, sourceId, createdAt])
  @@index([tenantId, sku])
  @@index([tenantId, name])
}

model AsyncConversationTurn {
  id                  String                      @id @default(cuid())
  tenantId            String
  conversationId      String
  status              AsyncConversationTurnStatus
  traceId             String
  locale              String?
  acceptedAt          DateTime                    @default(now())
  firstInputAt        DateTime
  lastInputAt         DateTime
  processingStartedAt DateTime?
  processingCompletedAt DateTime?
  flushAt             DateTime
  replyDueAt          DateTime?
  projectedAt         DateTime?
  supersededAt        DateTime?
  stabilizationDelayMs Int
  replyDelayMs        Int                         @default(0)
  inputCount          Int                         @default(1)
  semanticInput       String
  replyText           String?
  replyMessageMetadata Json?
  resultSummary       Json?
  assistantMessageId  String?
  supersededByTurnId  String?
  errorCode           String?
  errorMessage        String?
  metadata            Json?
  conversation        Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inputs              AsyncConversationTurnInput[]
  supersededBy        AsyncConversationTurn?      @relation("AsyncTurnSupersession", fields: [supersededByTurnId], references: [id], onDelete: SetNull)
  supersedes          AsyncConversationTurn[]     @relation("AsyncTurnSupersession")

  @@index([tenantId, conversationId, acceptedAt])
  @@index([tenantId, conversationId, status, acceptedAt])
  @@index([tenantId, traceId])
}

model AsyncConversationTurnInput {
  id         String                @id @default(cuid())
  tenantId   String
  turnId     String
  sequence   Int
  content    String
  locale     String?
  metadata   Json?
  receivedAt DateTime              @default(now())
  turn       AsyncConversationTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, sequence])
  @@index([tenantId, turnId, receivedAt])
}

model TestCenterConversationEvaluation {
  id                  String                      @id @default(cuid())
  tenantId            String
  conversationId      String                      @unique
  scenarioId          String?
  scenarioLabel       String
  scenarioSourceKind  TestCenterScenarioSourceKind
  locale              String?
  overallScore        Int
  correctnessScore    Int
  coherenceScore      Int
  fluencyScore        Int
  writingQualityScore Int
  status              TestCenterEvaluationStatus
  summary             Json?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  conversation        Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turnEvaluations     TestCenterTurnEvaluation[]

  @@index([tenantId, status, updatedAt])
  @@index([tenantId, scenarioSourceKind, updatedAt])
}

model TestCenterTurnEvaluation {
  id                  String                        @id @default(cuid())
  tenantId            String
  evaluationId        String
  turnIndex           Int
  traceId             String?
  userMessage         String
  assistantMessage    String
  overallScore        Int
  correctnessScore    Int
  coherenceScore      Int
  fluencyScore        Int
  writingQualityScore Int
  status              TestCenterEvaluationStatus
  summary             Json?
  createdAt           DateTime                      @default(now())
  evaluation          TestCenterConversationEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, turnIndex])
  @@index([tenantId, evaluationId, turnIndex])
}
