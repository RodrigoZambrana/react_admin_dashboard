  @@index([orderId])
  @@index([workOrderId])
  @@index([status])
  @@index([assignedToId])
}

model CurrencyRate {
  id        Int      @id @default(autoincrement())
  base      String
  quote     String
  rate      Decimal  @db.Decimal(18, 8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

