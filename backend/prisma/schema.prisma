  email        String?
  phone        String?
  website      String?
  addressLine1 String?
  addressLine2 String?
  logo         Bytes?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CustomerAddress {
  id           Int      @id @default(autoincrement())
  customerId   Int
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  street       String
  number       String
  corner       String?
  apartment    String?
  department   String?
  city         String
  neighborhood String?
  country      String
  comments     String?
  label        String?
  isPrimary    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InboxAccount {
  id            String           @id @default(cuid())
  displayName   String?
  address       String?
  channel       InboxChannelType
  active        Boolean          @default(true)
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  messages      InboxMessage[]
  syncStates    InboxSyncState[]
  conversations Conversation[]   @relation("ConversationInboxAccount")

  @@unique([channel, address])
}

model InboxMessage {
  id                   String                @id @default(cuid())
  accountId            String
  account              InboxAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channel              InboxChannelType
  provider             String                @default("generic")
  messageUid           String
  remoteId             String
  threadRemoteId       String?
  subject              String?
  snippet              String?
  previewText          String?
  fromAddress          String?
  fromName             String?
  toAddresses          String[]
  ccAddresses          String[]
  bccAddresses         String[]
  replyToAddresses     String[]
  direction            InboxMessageDirection
  folder               String?
  queueId              String?
  queue                InboxQueue?           @relation(fields: [queueId], references: [id], onDelete: SetNull)
  isRead               Boolean               @default(false)
  isStarred            Boolean               @default(false)
  isSpam               Boolean               @default(false)
  hasAttachments       Boolean               @default(false)
  sentAt               DateTime?
  receivedAt           DateTime?
  bodyHash             String?
  metadata             Json?
  attachments          InboxAttachment[]
  events               InboxMessageEvent[]
  conversationMessages ConversationMessage[] @relation("ConversationMessageInboxMessage")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([accountId, channel, remoteId])
  @@unique([messageUid, provider, folder])
  @@index([accountId, folder])
  @@index([accountId, isRead])
  @@index([accountId, sentAt])
  @@index([queueId, receivedAt])
}

model InboxAttachment {
  id          String       @id @default(cuid())
  messageId   String
  message     InboxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  remoteId    String?
  fileName    String?
  contentType String?
  size        Int?
  metadata    Json?
  createdAt   DateTime     @default(now())
}

model InboxSyncState {
  id           String           @id @default(cuid())
  accountId    String
  account      InboxAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channel      InboxChannelType
  folder       String
  lastRemoteId String?
  lastSyncAt   DateTime?
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([accountId, channel, folder])
}

model InboxQueue {
  id                       String                     @id @default(cuid())
  slug                     String                     @unique
  name                     String
  description              String?
  rules                    Json?
  isActive                 Boolean                    @default(true)
  priority                 Int                        @default(100)
  slaTargetMinutes         Int                        @default(30)
  maxAssignedConversations Int?
  assignmentMode           InboxQueueAssignmentMode   @default(MANUAL)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  messages                 InboxMessage[]
  assignments              InboxQueueUserAssignment[]
}

model InboxQueueUserAssignment {
  id                   String     @id @default(cuid())
  queueId              String
  queue                InboxQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  userId               Int
  user                 User       @relation("InboxQueueAssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  isActive             Boolean    @default(true)
  isPrimary            Boolean    @default(false)
  maxOpenConversations Int?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@unique([queueId, userId])
  @@index([queueId, isActive])
  @@index([userId, isActive])
}

model InboxMessageEvent {
  id         Int                   @id @default(autoincrement())
  messageId  String
  message    InboxMessage          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type       InboxMessageEventType
  payload    Json?
  occurredAt DateTime              @default(now())

  @@index([messageId, occurredAt])
}

model Conversation {
  id                  String                     @id @default(cuid())
  tenantKey           String
  scope               ConversationScope
  conversationRole    ConversationRole          @default(CUSTOMER_PUBLIC)
  channel             ConversationChannel
  status              ConversationStatus         @default(OPEN)
  controlMode         ConversationControlMode    @default(AI)
  needsHuman          Boolean                    @default(false)
  subject             String?
  customerId          Int?
  customer            Customer?                  @relation("ConversationCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  assignedToUserId    Int?
  assignedToUser      User?                      @relation("ConversationAssignedOperator", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  inboxAccountId      String?
  inboxAccount        InboxAccount?              @relation("ConversationInboxAccount", fields: [inboxAccountId], references: [id], onDelete: SetNull)
  externalUserId      String?
  externalThreadId    String?
  externalChannelRef  String?
  metadata            Json?
  pinnedAt            DateTime?
  lastMessageAt       DateTime?
  lastInboundAt       DateTime?
  lastOutboundAt      DateTime?
  closedAt            DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  participants        ConversationParticipant[]
  messages            ConversationMessage[]
  handoffEvents       ConversationHandoffEvent[]
  toolCalls           ConversationToolCall[]
  readStates          ConversationReadState[]
  knowledgeCandidates KnowledgeCandidate[]
  knowledgeRawEvents  KnowledgeRawEvent[]
  knowledgeSuggestionFeedbacks KnowledgeSuggestionFeedback[]
  knowledgeConversationBundle KnowledgeConversationBundle?
  knowledgeNegativeExamples KnowledgeNegativeExample[]

  @@unique([tenantKey, channel, externalThreadId])
  @@index([tenantKey, scope, channel, status])
  @@index([conversationRole, lastMessageAt])
  @@index([assignedToUserId, status, lastMessageAt])
  @@index([customerId, lastMessageAt])
  @@index([inboxAccountId, channel, lastMessageAt])
}

model ConversationReadState {
  conversationId String
  userId         Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  manualUnread   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([conversationId, userId])
  @@index([userId, updatedAt])
}

model ConversationParticipant {
  id             String                      @id @default(cuid())
  conversationId String
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ConversationParticipantRole
  userId         Int?
  user           User?                       @relation("ConversationParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  customerId     Int?
  customer       Customer?                   @relation("ConversationParticipantCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  externalUserId String?
  displayName    String?
  metadata       Json?
  createdAt      DateTime                    @default(now())

  @@index([conversationId, role])
  @@index([userId])
  @@index([customerId])
}

model ConversationMessage {
  id                  String                        @id @default(cuid())
  conversationId      String
  conversation        Conversation                  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorType          ConversationMessageAuthorType
  kind                ConversationMessageKind       @default(TEXT)
  authorUserId        Int?
  authorUser          User?                         @relation("ConversationMessageAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorCustomerId    Int?
  authorCustomer      Customer?                     @relation("ConversationMessageAuthorCustomer", fields: [authorCustomerId], references: [id], onDelete: SetNull)
  externalMessageId   String?
  inboxMessageId      String?
  inboxMessage        InboxMessage?                 @relation("ConversationMessageInboxMessage", fields: [inboxMessageId], references: [id], onDelete: SetNull)
  body                String?
  normalizedText      String?
  payload             Json?
  metadata            Json?
  sentAt              DateTime?
  receivedAt          DateTime?
  createdAt           DateTime                      @default(now())
  toolCalls           ConversationToolCall[]
  knowledgeCandidates KnowledgeCandidate[]
  knowledgeRawEvents  KnowledgeRawEvent[]
  targetedKnowledgeSuggestionFeedbacks KnowledgeSuggestionFeedback[] @relation("KnowledgeSuggestionTargetMessage")
  operatorKnowledgeSuggestionFeedbacks KnowledgeSuggestionFeedback[] @relation("KnowledgeSuggestionOperatorMessage")

  @@index([conversationId, createdAt])
  @@index([externalMessageId])
  @@index([inboxMessageId])
}

model ConversationHandoffEvent {
  id             String                       @id @default(cuid())
  conversationId String
  conversation   Conversation                 @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           ConversationHandoffEventType
  actorUserId    Int?
  actorUser      User?                        @relation("ConversationHandoffActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  previousMode   ConversationControlMode?
  nextMode       ConversationControlMode?
  notes          String?
  metadata       Json?
  createdAt      DateTime                     @default(now())

  @@index([conversationId, createdAt])
}

model ConversationToolCall {
  id                String                        @id @default(cuid())
  conversationId    String
  conversation      Conversation                  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId         String?
  message           ConversationMessage?          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  toolName          String
  status            ConversationToolCallStatus    @default(REQUESTED)
  requestedBy       ConversationMessageAuthorType
  requestedByUserId Int?
  requestedByUser   User?                         @relation("ConversationToolRequestedByUser", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  validatedPayload  Json?
  resultPayload     Json?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@index([conversationId, status, createdAt])
  @@index([messageId])
}

model KnowledgeDocument {
  id               String                      @id @default(cuid())
  tenantKey        String
  scope            KnowledgeDocumentScope
  sourceType       KnowledgeSourceType
  status           KnowledgeDocumentStatus     @default(ACTIVE)
  sourceKey        String
  title            String
  summary          String?
  content          String
  sourceFileName   String?
  sourceFilePath   String?
  sourceFileMime   String?
  sourceFileSize   Int?
  tags             String[]                    @default([])
  piiRiskLevel     String?                     @default("low")
  metadata         Json?
  authoredByUserId Int?
  authoredByUser   User?                       @relation("KnowledgeDocumentAuthoredByUser", fields: [authoredByUserId], references: [id], onDelete: SetNull)
  approvedByUserId Int?
  approvedByUser   User?                       @relation("KnowledgeDocumentApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  embedding        KnowledgeDocumentEmbedding?
  derivedArtifacts KnowledgeDerivedArtifact[]

  @@unique([tenantKey, scope, sourceType, sourceKey])
  @@index([tenantKey, scope, status, sourceType])
}

model KnowledgeDocumentEmbedding {
  id          String            @id @default(cuid())
  documentId  String            @unique
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  provider    String
  model       String
  dimensions  Int
  contentHash String
  vector      Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([provider, model])
}

model KnowledgeDerivedArtifact {
  id               String                         @id @default(cuid())
  tenantKey        String
  scope            KnowledgeDocumentScope
  type             KnowledgeDerivedArtifactType
  status           KnowledgeDerivedArtifactStatus @default(ACTIVE)
  sourceDocumentId String
  sourceDocument   KnowledgeDocument             @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  content          Json
  metadata         Json?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@index([tenantKey, scope, type, status])
  @@index([sourceDocumentId])
}

model KnowledgeCandidate {
  id               String                   @id @default(cuid())
  tenantKey        String
  scope            KnowledgeDocumentScope
  sourceType       KnowledgeSourceType      @default(CONVERSATION_DERIVED)
  status           KnowledgeCandidateStatus @default(PENDING)
  observationId    String?                  @unique
  observation      KnowledgeRawEvent?       @relation(fields: [observationId], references: [id], onDelete: SetNull)
  title            String
  excerpt          String
  redactedExcerpt  String?
  summary          String?
  detectedIntent   String?
  problem          String?
  contextSummary   String?
  suggestedResponse String?
  approvedResponse String?
  confidence       Float?
  dedupeHash       String?
  clusterKey       String?
  version          Int                      @default(1)
  piiDetected      Boolean                  @default(false)
  metadata         Json?
  conversationId   String?
  conversation     Conversation?            @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId        String?
  message          ConversationMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdByUserId  Int?
  createdByUser    User?                    @relation("KnowledgeCandidateCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedByUserId Int?
  reviewedByUser   User?                    @relation("KnowledgeCandidateReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  suggestionFeedbacks KnowledgeSuggestionFeedback[]
  negativeExamples KnowledgeNegativeExample[]

  @@index([tenantKey, scope, status, sourceType, createdAt])
  @@index([conversationId, createdAt])
  @@index([messageId])
  @@index([tenantKey, dedupeHash, status])
  @@index([tenantKey, detectedIntent, status])
}

model KnowledgeRawEvent {
  id                   String                      @id @default(cuid())
  tenantKey            String
  scope                KnowledgeDocumentScope
  channel              ConversationChannel
  sourceAuthorType     ConversationMessageAuthorType
  status               KnowledgeRawEventStatus    @default(NEW)
  conversationId       String?
  conversation         Conversation?              @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId            String?                    @unique
  message              ConversationMessage?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  userMessage          String
  normalizedMessage    String
  redactedMessage      String?
  operatorReply        String?
  aiReply              String?
  detectedIntent       String?
  problem              String?
  contextSummary       String?
  suggestedResponse    String?
  confidence           Float?
  relevanceScore       Float?
  dedupeHash           String?
  clusterKey           String?
  messageElements      Json?
  messageContextOrigin Json?
  attachments          Json?
  metadata             Json?
  ingestionRunId       String?
  ingestionRun         KnowledgeIngestionRun?     @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  candidate            KnowledgeCandidate?

  @@index([tenantKey, scope, status, createdAt])
  @@index([conversationId, createdAt])
  @@index([ingestionRunId])
  @@index([tenantKey, dedupeHash])
}

model KnowledgeIngestionRun {
  id               String                     @id @default(cuid())
  tenantKey        String
  sourceType       String
  triggerType      String
  status           KnowledgeIngestionRunStatus @default(RUNNING)
  processedCount   Int                        @default(0)
  createdCandidates Int                       @default(0)
  skippedCount     Int                        @default(0)
  errorCount       Int                        @default(0)
  metadata         Json?
  createdByUserId  Int?
  createdByUser    User?                      @relation("KnowledgeIngestionRunCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  startedAt        DateTime                   @default(now())
  finishedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  observations     KnowledgeRawEvent[]

  @@index([tenantKey, status, startedAt])
  @@index([createdByUserId, startedAt])
}

model KnowledgeSuggestionFeedback {
  id               String                           @id @default(cuid())
  tenantKey        String
  conversationId   String
  conversation     Conversation                     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        KnowledgeCandidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  targetMessageId  String?
  targetMessage    ConversationMessage?             @relation("KnowledgeSuggestionTargetMessage", fields: [targetMessageId], references: [id], onDelete: SetNull)
  operatorMessageId String?
  operatorMessage  ConversationMessage?             @relation("KnowledgeSuggestionOperatorMessage", fields: [operatorMessageId], references: [id], onDelete: SetNull)
  actorUserId      Int?
  actorUser        User?                            @relation("KnowledgeSuggestionFeedbackActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  outcome          KnowledgeSuggestionFeedbackOutcome
  suggestedText    String?
  finalText        String?
  metadata         Json?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  negativeExample  KnowledgeNegativeExample?

  @@index([tenantKey, candidateId, outcome, createdAt])
  @@index([conversationId, createdAt])
  @@index([targetMessageId])
  @@index([operatorMessageId])
  @@index([actorUserId, createdAt])
}

model KnowledgeConversationBundle {
  id               String                            @id @default(cuid())
  tenantKey        String
  scope            KnowledgeDocumentScope
  status           KnowledgeConversationBundleStatus @default(PENDING)
  conversationId   String                            @unique
  conversation     Conversation                      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title            String
  summary          String?
  detectedIntents  String[]                          @default([])
  eventCount       Int                               @default(0)
  candidateCount   Int                               @default(0)
  approvedCount    Int                               @default(0)
  pendingCount     Int                               @default(0)
  previewQuestion  String?
  previewResponse  String?
  metadata         Json?
  createdByUserId  Int?
  createdByUser    User?                             @relation("KnowledgeConversationBundleCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedByUserId Int?
  reviewedByUser   User?                             @relation("KnowledgeConversationBundleReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt

  @@index([tenantKey, scope, status, updatedAt])
  @@index([tenantKey, conversationId])
}

model KnowledgeNegativeExample {
  id               String                            @id @default(cuid())
  tenantKey        String
  scope            KnowledgeDocumentScope
  status           KnowledgeNegativeExampleStatus    @default(PENDING)
  sourceKind       KnowledgeNegativeExampleSourceKind
  conversationId   String?
  conversation     Conversation?                     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  candidateId      String?
  candidate        KnowledgeCandidate?               @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  feedbackId       String?                           @unique
  feedback         KnowledgeSuggestionFeedback?      @relation(fields: [feedbackId], references: [id], onDelete: SetNull)
  title            String
  summary          String?
  detectedIntent   String?
  channel          ConversationChannel?
  disallowedText   String
  correctedText    String?
  metadata         Json?
  createdByUserId  Int?
  createdByUser    User?                             @relation("KnowledgeNegativeExampleCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedByUserId Int?
  reviewedByUser   User?                             @relation("KnowledgeNegativeExampleReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt

  @@index([tenantKey, scope, status, sourceKind, updatedAt])
  @@index([tenantKey, conversationId, updatedAt])
}

model KnowledgeSnapshot {
  id                String                  @id @default(cuid())
  tenantKey         String
  scope             KnowledgeDocumentScope
  status            KnowledgeSnapshotStatus @default(BUILDING)
  version           Int
  generationReason  String
  summaryText       String?
  metrics           Json?
  coverageScore     Float?
  metadata          Json?
  generatedByUserId Int?
  generatedByUser   User?                   @relation("KnowledgeSnapshotGeneratedByUser", fields: [generatedByUserId], references: [id], onDelete: SetNull)
  generatedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  entries           KnowledgeSnapshotEntry[]

  @@unique([tenantKey, scope, version])
  @@index([tenantKey, scope, status, generatedAt])
}

model KnowledgeSnapshotEntry {
  id                String                     @id @default(cuid())
  snapshotId        String
  snapshot          KnowledgeSnapshot          @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  tenantKey         String
  scope             KnowledgeDocumentScope
  entryType         KnowledgeSnapshotEntryType
  key               String
  title             String
  plainText         String
  normalizedIntent  String?
  topicKey          String?
  confidence        Float?
  priority          String?
  appliesToChannels String[]                   @default([])
  metadata          Json?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  sources           KnowledgeSnapshotSource[]

  @@index([snapshotId, entryType])
  @@index([tenantKey, scope, entryType])
  @@index([snapshotId, key])
}

model KnowledgeSnapshotSource {
  id              String                      @id @default(cuid())
  snapshotEntryId String
  snapshotEntry   KnowledgeSnapshotEntry      @relation(fields: [snapshotEntryId], references: [id], onDelete: Cascade)
  sourceKind      KnowledgeSnapshotSourceKind
  sourceId        String
  sourceVersion   Int?
  sourceStatus    String?
  role            KnowledgeSnapshotSourceRole
  excerpt         String?
  metadata        Json?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([snapshotEntryId])
  @@index([sourceKind, sourceId])
}

model EmailSetting {
  id              Int           @id @default(autoincrement())
  category        EmailCategory @unique
  fromAddress     String
  fromName        String?
  adminRecipients String[]      @default([])
  cc              String[]      @default([])
  bcc             String[]      @default([])
  enabled         Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model EmailTemplate {
  id        Int                  @id @default(autoincrement())
  category  EmailCategory
  locale    String               @default("en")
  variant   EmailTemplateVariant
  subject   String
  body      String
  version   Int                  @default(1)
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  logs      EmailLog[]

  @@unique([category, locale, variant, version])
  @@index([category, locale, active])
}

model RoleNotificationRule {
  id         Int             @id @default(autoincrement())
  role       Role
  categories EmailCategory[]
  enabled    Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model EmailLog {
  id                Int                @id @default(autoincrement())
  category          EmailCategory
  templateId        Int?
  template          EmailTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  locale            String
  recipientType     EmailRecipientType
  toAddress         String
  ccAddresses       String[]           @default([])
  bccAddresses      String[]           @default([])
  subject           String
  payload           Json
  payloadHash       String
  status            EmailLogStatus     @default(QUEUED)
  providerMessageId String?
  errorMessage      String?
  attempts          Int                @default(0)
  lastAttemptAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([category, status, createdAt])
  @@index([toAddress, createdAt])
  @@index([templateId])
}

model PasswordResetToken {
  id                   Int                  @id @default(autoincrement())
  tokenHash            String               @unique
  userId               Int?
  user                 User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId           Int?
  customer             Customer?            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel              PasswordResetChannel @default(EMAIL)
  targetIdentifierHash String?
  signingKid           String?
  metadata             Json?
  expiresAt            DateTime
  usedAt               DateTime?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([userId])
  @@index([customerId])
  @@index([expiresAt])
  @@index([channel])
}

model DimensionPriceMatrix {
  id                       Int       @id @default(autoincrement())
  productId                Int
  product                  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  fingerprint              String    @db.Char(64)
  optionState              String    @default("BASE") @map("option_state")
  familyId                 String
  serie                    String
  material                 String
  color                    String
  vidrio                   String
  widthMm                  Int
  heightMm                 Int
  hasMosquitero            Boolean   @default(false)
  hasShutterMonoblock      Boolean   @default(false)
  shutterSystem            String    @default("")
  price                    Decimal   @db.Decimal(14, 4)
  priceBase                Decimal?  @db.Decimal(14, 4)
  priceMosquitero          Decimal?  @db.Decimal(14, 4)
  priceMonoblock           Decimal?  @db.Decimal(14, 4)
  priceMonoblockMosquitero Decimal?  @db.Decimal(14, 4)
  hasMosquiteroOption      Boolean   @default(false)
  hasMonoblockOption       Boolean   @default(false)
  currency                 String    @default("USD")
  detailSnapshot           String?
  priceLineage             Json?     @map("price_lineage")
  conflictFlags            String[]  @default([]) @map("conflict_flags")
  source                   String?
  referenceDate            DateTime? @map("reference_date")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([productId, fingerprint, optionState])
  @@index([productId])
  @@map("dimension_price_matrix")
}

model ParametricMatrixStaging {
  id                       Int       @id @default(autoincrement())
  productId                Int
  product                  Product   @relation("ProductParametricMatrixStaging", fields: [productId], references: [id], onDelete: Cascade)
  fingerprint              String    @db.Char(64)
  optionState              String    @default("BASE") @map("option_state")
  familyId                 String
  serie                    String
  material                 String
  color                    String
  vidrio                   String
  widthMm                  Int
  heightMm                 Int
  hasMosquitero            Boolean   @default(false)
  hasShutterMonoblock      Boolean   @default(false)
  shutterSystem            String    @default("")
  hasMosquiteroOption      Boolean   @default(false)
  hasMonoblockOption       Boolean   @default(false)
  priceBase                Decimal?  @db.Decimal(14, 4)
  priceMosquitero          Decimal?  @db.Decimal(14, 4)
  priceMonoblock           Decimal?  @db.Decimal(14, 4)
  priceMonoblockMosquitero Decimal?  @db.Decimal(14, 4)
  currency                 String    @default("USD")
  specifications           String?
  sourceSystem             String
  sourceRecordId           String?
  source                   String?
  referenceDate            DateTime? @map("reference_date")
  ingestedAt               DateTime  @default(now())
