  createdAt DateTime @default(now())
}

model ProductionOrder {
  id           Int             @id @default(autoincrement())
  workOrderId  Int
  workOrder    WorkOrder       @relation("WorkOrderProduction", fields: [workOrderId], references: [id], onDelete: Cascade)
