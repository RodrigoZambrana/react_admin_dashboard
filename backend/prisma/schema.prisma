// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  SUPERADMIN
  ADMIN
  USER
}

enum EventType {
  MEETING
  TASK
  WORKSHOP
  OTHER
}

// Notification
model Notification {
  id             Int       @id @default(autoincrement())
  recipientId    Int?
  recipient      User?     @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  target         String?
  description    String?
  type           Int       @default(0)
  image          String?
  location       String?
  locationLabel  String?
  status         String?   // e.g. info, success, warning
  readed         Boolean   @default(false)
  createdAt      DateTime  @default(now())
}

// Users and Auth
model User {
  id           Int      @id @default(autoincrement())
  userName     String   @unique
  name         String?
  email        String   @unique
  img          String?
  role         Role     @default(USER)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // relations
  createdTasks Task[]
  taskAssignees TaskAssignee[]
  events       CalendarEvent[]
  notifications Notification[]
}

// CRM Customer
model Customer {
  id          Int       @id @default(autoincrement())
  name        String
  firstName   String?
  lastName    String?
  email       String
  img         String?
  location    String?
  title       String?
  phoneNumber String?
  birthday    DateTime?
  facebook    String?
  twitter     String?
  pinterest   String?
  linkedIn    String?
  phones      CustomerPhone[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orders      Order[]
  addresses   CustomerAddress[]
  statusId    Int?
  status      CustomerStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
}

model CustomerPhone {
  id         Int       @id @default(autoincrement())
  customerId Int
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String
  label      String?
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

// Sales Product
model Product {
  id                Int             @id @default(autoincrement())
  name              String
  productCode       String?
  img               String?
  description       String?
  categoryId        Int?
  category          ProductCategory? @relation(fields: [categoryId], references: [id])
  price             Float            @default(0)
  stock             Int              @default(0)
  status            Int              @default(0) // 0=inStock,1=limited,2=outOfStock
  costPerItem       Float?
  bulkDiscountPrice Float?
  taxRate           Float?           @default(22)
  tags              String[]
  brand             String?
  vendor            String?
  published         Boolean          @default(true)
  images            ProductImage[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  orderItems        OrderItem[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String?
  img       String
  sortOrder Int     @default(0)
}

model ProductCategory {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  products Product[]
}

model ProductStatus {
  id    Int    @id @default(autoincrement())
  code  Int    @unique
  name  String
  color String?
}

model SystemConfig {
  key   String @id
  value String
}

// Sales Orders
model Order {
  id                  Int           @id @default(autoincrement())
  customerId          Int
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date                DateTime      @default(now())
  paymentMethodId     Int?
  paymentMethod       PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  shippingAddress1    String?
  shippingAddress2    String?
  shippingCity        String?
  shippingState       String?
  shippingZip         String?
  billingAddress1     String?
  billingAddress2     String?
  billingCity         String?
  billingState        String?
  billingZip          String?
  billingSameAsShipping Boolean     @default(false)
  shippingVendor      String?       // e.g., FedEx
  deliveryFees        Float?        @default(0)
  estimatedMin        Int?          @default(1)
  estimatedMax        Int?          @default(3)
  comment             String?
  statusId            Int?
  status              OrderStatus?  @relation(fields: [statusId], references: [id], onDelete: SetNull)
  subTotal            Float         @default(0)
  tax                 Float         @default(0)
  grandTotal          Float         @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  items               OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Float    @default(0)
  qty       Int      @default(1)
  img       String?
  description String?
}

model PaymentMethod {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  orders Order[]
}

model OrderStatus {
  id    Int    @id @default(autoincrement())
  code  Int    @unique
  name  String
  color String?
  orders Order[]
}

// Expenses
model Expense {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  amount      Float          @default(0)
  date        DateTime       @default(now())
  categoryId  Int?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  statusId    Int?
  status      ExpenseStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ExpenseCategory {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  expenses Expense[]
}

model ExpenseStatus {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  color    String?
  expenses Expense[]
}

model CustomerStatus {
  id    Int    @id @default(autoincrement())
  name  String @unique
  color String?
  customers Customer[]
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  code        String?
  description String?
  startDate   DateTime? @default(now())
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]
  events      CalendarEvent[]
}

model Task {
  id          Int       @id @default(autoincrement())
  code        String?
  subject     String
  description String?
  priority    Int       @default(1) // 0=High,1=Medium,2=Low
  status      String?
  projectId   Int?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  assignees   TaskAssignee[]
  events      CalendarEvent[]
}

model TaskAssignee {
  taskId Int
  userId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([taskId, userId])
}

model CalendarEvent {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  type        EventType  @default(OTHER)
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean    @default(false)
  location    String?
  color       String?    @db.VarChar(32)
  metadata    Json?
  createdById Int?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  projectId   Int?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId      Int?
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
model CustomerAddress {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  street     String
  number     String
  corner     String?
  apartment  String?
  city       String
  country    String
  isPrimary  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
