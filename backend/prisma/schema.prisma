}

model PaymentPlanMilestone {
  id              Int                    @id @default(autoincrement())
  paymentPlanId   Int
  paymentPlan     PaymentPlan            @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  name            String
  dueDate         DateTime?
  requirementType DepositRequirementType @default(PERCENTAGE)
  value           Decimal                @default(0) @db.Decimal(18, 4)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([paymentPlanId])
}

model WorkOrder {
  id               Int               @id @default(autoincrement())
  orderId          Int
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  code             String            @unique
  status           WorkOrderStatus   @default(PENDING)
  issuedAt         DateTime          @default(now())
  startedAt        DateTime?
