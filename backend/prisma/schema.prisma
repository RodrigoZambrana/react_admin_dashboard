  value String
}

model SecureConfig {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Sales Orders
model Order {
  id                    Int                       @id @default(autoincrement())
  uuid                  String                    @unique @default(uuid())
  documentType          DocumentType              @default(ORDER)
  customerId            Int
  customer              Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date                  DateTime                  @default(now())
  paymentMethodId       Int?
  shippingAddress1      String?
  shippingAddress2      String?
  shippingCity          String?
  shippingDepartment    String?
  shippingState         String?
  shippingNeighborhood  String?
  shippingZip           String?
  shippingCountry       String?
  billingAddress1       String?
  billingAddress2       String?
  billingCity           String?
  billingDepartment     String?
  billingState          String?
  billingNeighborhood   String?
  billingZip            String?
  billingCountry        String?
  billingSameAsShipping Boolean                   @default(false)
  shippingVendor        String? // e.g., FedEx
  deliveryFees          Decimal?                  @default(0) @db.Decimal(18, 2)
  estimatedMin          Int?                      @default(1)
  estimatedMax          Int?                      @default(3)
  comment               String?
  disclaimer            String?
  statusId              Int?
  subTotal              Decimal                   @default(0) @db.Decimal(18, 2)
  tax                   Decimal                   @default(0) @db.Decimal(18, 2)
  grandTotal            Decimal                   @default(0) @db.Decimal(18, 2)
  minimumDepositType    DepositRequirementType    @default(PERCENTAGE)
  minimumDepositValue   Decimal                   @default(0) @db.Decimal(18, 2)
  confirmedAt           DateTime?
  depositSatisfiedAt    DateTime?
  customerCredit        Decimal                   @default(0) @db.Decimal(18, 2)
  orderCurrency         String                    @default("UYU")
  fxBase                String?
  fxRates               Json?
  currencySnapshot      String?
  taxRateSnapshot       Decimal?                  @db.Decimal(18, 4)
  priceListIdSnapshot   Int?
  exchangeRateSnapshot  Json?
  validUntil            DateTime?
  activityId            Int?
  activity              CalendarEvent?            @relation(fields: [activityId], references: [id], onDelete: SetNull)
  originId              Int?
  origin                Order?                    @relation("OrderOrigin", fields: [originId], references: [id], onDelete: SetNull)
  convertedOrderId      Int?
  convertedOrder        Order?                    @relation("OrderConversion", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  convertedAt           DateTime?
  convertedBy           Int?
  convertedByUser       User?                     @relation("OrderConvertedBy", fields: [convertedBy], references: [id], onDelete: SetNull)
  documentFilePath      String?
  documentFileName      String?
  documentFileMime      String?
  documentFileSize      Int?
  documentGeneratedAt   DateTime?
  documentPdf           Bytes?
  version               Int                       @default(1)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  items                 OrderItem[]
  conversions           Order[]                   @relation("OrderOrigin")
  budgetSource          Order?                    @relation("OrderConversion")
  payments              Payment[]
  notifications         Notification[]
  paymentPlan           PaymentPlan?
  workOrders            WorkOrder[]
  productionOrders      ProductionOrder[]         @relation("OrderProduction")
  storefrontPayments    StorefrontPaymentIntent[]
  timelineEvents        OrderTimelineEvent[]

  @@unique([originId])
  @@unique([convertedOrderId])
  @@index([activityId])
  @@index([documentType, statusId, customerId, createdAt])
  @@index([documentType, createdAt])
  @@index([customerId, documentType, date])
  @@index([validUntil])
}

model OrderTimelineEvent {
  id              Int       @id @default(autoincrement())
  eventId         String    @unique
  orderId         Int
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type            String
  timestamp       DateTime  @default(now())
  actor           String?
  amount          Decimal?  @db.Decimal(18, 2)
  currency        String?
  paymentMethod   String?
  remainingAmount Decimal?  @db.Decimal(18, 2)
  estimateDate    DateTime?
  statusFrom      String?
  statusTo        String?
  message         String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId, timestamp])
  @@index([orderId, type])
  @@index([orderId, timestamp, id], map: "order_timeline_order_timestamp_id_idx")
}

model OrderItem {
  id                      Int             @id @default(autoincrement())
  orderId                 Int
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId               Int?
  product                 Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId               Int?
  variant                 ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name                    String
  price                   Decimal         @default(0) @db.Decimal(18, 2)
  qty                     Int             @default(1)
  img                     String?
  description             String?
  comments                String?
  unitAmount              Decimal?        @db.Decimal(18, 4)
  unitCurrency            String?
  unitAmountOrderCurrency Decimal?        @db.Decimal(18, 4)
  conversionRate          Decimal?        @db.Decimal(18, 8)
  unitCostAmount          Decimal?        @db.Decimal(18, 4)
  unitCostCurrency        String?
  unitCostOrderCurrency   Decimal?        @db.Decimal(18, 4)
  customAttributes        Json?           @default("{}")
  pricingMethodSnapshot   SalesUnit?
  unitPriceSnapshot       Decimal?        @db.Decimal(18, 4)
  skuSnapshot             String?
  nameSnapshot            String?
  specSummary             String?
  specJson                Json?           @default("{}")
  parametricConfig        Json?
  parametricBreakdown     Json?
  parametricReferenceDate DateTime?
  parametricSource        String?
  parametricVersion       String?
}

model Payment {
  id              Int                 @id @default(autoincrement())
  orderId         Int
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethodId Int?
  method          String?
  amount          Decimal             @db.Decimal(18, 2)
  currency        String
  type            PaymentType         @default(BALANCE)
  status          PaymentStatus       @default(REGISTERED)
  reference       String?
  date            DateTime            @default(now())
  notes           String?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  attachments     PaymentAttachment[]
  notifications   Notification[]

  @@unique([orderId, reference])
  @@index([orderId])
  @@index([status, type])
  @@index([orderId, status, date])
  @@index([paymentMethodId])
}

model PaymentPlan {
  id          Int                    @id @default(autoincrement())
  orderId     Int                    @unique
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name        String?
