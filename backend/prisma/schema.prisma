generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  SUPERADMIN
  ADMIN
  USER
  OPS
  SALES
  FINANCE
}

enum UserCapability {
  CONVERSATIONS_MANAGE
  CUSTOMERS_MANAGE
  APPOINTMENTS_MANAGE
  CATALOG_MANAGE
  ORDERS_MANAGE
  QUOTES_MANAGE
  PAYMENTS_MANAGE
  ABERTURAS_QUOTE
  ABERTURAS_REGISTER
  KNOWLEDGE_MANAGE
  AI_SETTINGS_MANAGE
  USERS_MANAGE
}

enum UserCapabilityGroup {
  SUPPORT
  SALES
  OPERATIONS
  FINANCE
  PLATFORM_ADMIN
}

enum EventType {
  MEETING
  TASK
  WORKSHOP
  OTHER
}

enum UserActivityType {
  LOGIN
  PASSWORD_CHANGE
  DEVICE_SIGN_IN
  PROFILE_UPDATE
  SECURITY_ALERT
}

enum SalesUnit {
  UNIT
  SQUARE_METER
  LINEAR_METER
}

enum DocumentType {
