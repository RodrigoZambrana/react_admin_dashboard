// Notifications
model Notification {
  id                  Int                        @id @default(autoincrement())
  eventType           NotificationEventType?
  audience            NotificationAudience?
  channel             NotificationChannel?
  deliveryStatus      NotificationDeliveryStatus @default(PENDING)
  recipientId         Int?
  recipient           User?                      @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  customerId          Int?
  customer            Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId             Int?
  order               Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId           Int?
  payment             Payment?                   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  title               String?
  body                String?
  metadata            Json?
  idempotencyKey      String?                    @unique(map: "notification_idempotency_key_unique")
  readAt              DateTime?
  readed              Boolean                    @default(false)
  legacyTarget        String?                    @map("target")
  legacyDescription   String?                    @map("description")
  legacyType          Int                        @default(0) @map("type")
  legacyImage         String?                    @map("image")
  legacyLocation      String?                    @map("location")
  legacyLocationLabel String?                    @map("locationLabel")
  legacyStatus        String?                    @map("status")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([recipientId, readAt], map: "notification_recipient_read_at_idx")
  @@index([customerId, readAt], map: "notification_customer_read_at_idx")
  @@index([eventType, audience, channel], map: "notification_event_audience_channel_idx")
  @@index([customerId, audience, createdAt], map: "notification_customer_audience_created_at_idx")
  @@index([recipientId, audience, createdAt], map: "notification_recipient_audience_created_at_idx")
  @@index([orderId, id], map: "notification_order_id_id_idx")
}

model NotificationSetting {
  id              Int                   @id @default(autoincrement())
  eventType       NotificationEventType
  audience        NotificationAudience
  channel         NotificationChannel
  enabled         Boolean               @default(true)
  roles           String[]              @default([])
  templateKey     String?
  localeOverrides Json?
  emailSubject    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([eventType, audience, channel], map: "notification_settings_event_channel_unique")
}

// Users and Auth
model User {
  id                             Int                        @id @default(autoincrement())
  name                           String?
  lastName                       String?
  email                          String                     @unique
  phone                          String?                    @unique
  img                            String?
  role                           Role                       @default(USER)
  status                         UserStatus                 @default(ACTIVE)
  capabilityGroups               UserCapabilityGroup[]      @default([])
  directCapabilities             UserCapability[]           @default([])
  lang                           String                     @default("en")
  country                        String?
  countryCode                    String?
  city                           String?
  passwordHash                   String
  createdAt                      DateTime                   @default(now())
  updatedAt                      DateTime                   @updatedAt
  // relations
  createdTasks                   Task[]
  taskAssignees                  TaskAssignee[]
  events                         CalendarEvent[]
  notifications                  Notification[]
  activityTicketMembers          ActivityTicketMember[]
  calendarComments               CalendarEventComment[]
  activities                     UserActivity[]
  devices                        UserDevice[]
  convertedOrders                Order[]                    @relation("OrderConvertedBy")
  assignedProductionOrders       ProductionOrder[]          @relation("ProductionOrderAssignedTo")
  passwordResetTokens            PasswordResetToken[]
  otpCodes                      OtpCode[]
  securityEvents                SecurityEvent[]
  assignedConversations          Conversation[]             @relation("ConversationAssignedOperator")
  conversationParticipants       ConversationParticipant[]  @relation("ConversationParticipantUser")
  authoredConversationMessages   ConversationMessage[]      @relation("ConversationMessageAuthorUser")
  conversationHandoffEvents      ConversationHandoffEvent[] @relation("ConversationHandoffActorUser")
  requestedConversationToolCalls ConversationToolCall[]     @relation("ConversationToolRequestedByUser")
  conversationReadStates         ConversationReadState[]
  inboxQueueAssignments          InboxQueueUserAssignment[] @relation("InboxQueueAssignedUser")
  authoredKnowledgeDocuments     KnowledgeDocument[]        @relation("KnowledgeDocumentAuthoredByUser")
  approvedKnowledgeDocuments     KnowledgeDocument[]        @relation("KnowledgeDocumentApprovedByUser")
  createdKnowledgeCandidates     KnowledgeCandidate[]       @relation("KnowledgeCandidateCreatedByUser")
  reviewedKnowledgeCandidates    KnowledgeCandidate[]       @relation("KnowledgeCandidateReviewedByUser")
  createdKnowledgeIngestionRuns  KnowledgeIngestionRun[]    @relation("KnowledgeIngestionRunCreatedByUser")
  knowledgeSuggestionFeedbacks   KnowledgeSuggestionFeedback[] @relation("KnowledgeSuggestionFeedbackActorUser")
  generatedKnowledgeSnapshots    KnowledgeSnapshot[]        @relation("KnowledgeSnapshotGeneratedByUser")
  createdKnowledgeConversationBundles KnowledgeConversationBundle[] @relation("KnowledgeConversationBundleCreatedByUser")
  reviewedKnowledgeConversationBundles KnowledgeConversationBundle[] @relation("KnowledgeConversationBundleReviewedByUser")
  createdKnowledgeNegativeExamples KnowledgeNegativeExample[] @relation("KnowledgeNegativeExampleCreatedByUser")
  reviewedKnowledgeNegativeExamples KnowledgeNegativeExample[] @relation("KnowledgeNegativeExampleReviewedByUser")
}

model UserDevice {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint   String         @unique
  displayName   String?
  userAgent     String?
  location      String?
  lastIpAddress String?
  deviceType    String?
  firstSeenAt   DateTime       @default(now())
  lastSeenAt    DateTime       @default(now())
  activities    UserActivity[]
}

model UserActivity {
  id          Int              @id @default(autoincrement())
  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        UserActivityType
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  deviceId    Int?
  device      UserDevice?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  performedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())
}

model OtpCode {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  type        OtpCodeType
  expiresAt   DateTime
  attempts    Int           @default(0)
  consumedAt  DateTime?
  target      String?
  channel     String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, type, createdAt])
  @@index([expiresAt])
  @@index([target])
  @@map("otp_codes")
}

model SecurityEvent {
  id          Int               @id @default(autoincrement())
  userId      Int?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType   SecurityEventType
  channel     String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("security_events")
}

// CRM Customer
model Customer {
  id                            Int                              @id @default(autoincrement())
  name                          String
  firstName                     String?
  lastName                      String?
  email                         String?                          @unique
  emailVerifiedAt               DateTime?
  img                           String?
  location                      String?
  title                         String?
  phoneNumber                   String?                          @unique
  passwordHash                  String?
  storefrontDefaultPasswordHash String?
  passwordAlgorithm             String?                          @default("bcrypt")
  passwordAlgVersion            Int?                             @default(12)
  passwordUpdatedAt             DateTime?
  storefrontSessionVersion      Int                              @default(1)
  birthday                      DateTime?
  facebook                      String?
  twitter                       String?
  pinterest                     String?
  linkedIn                      String?
  phones                        CustomerPhone[]
  preferredLocale               String                           @default("es")
  preferredCurrency             String                           @default("UYU")
  createdAt                     DateTime                         @default(now())
  updatedAt                     DateTime                         @updatedAt
  orders                        Order[]
  notifications                 Notification[]
  passwordResetTokens           PasswordResetToken[]
  emailVerificationTokens       CustomerEmailVerificationToken[]
  securityEvents                CustomerSecurityEvent[]
  otpChallenges                 CustomerOtpChallenge[]
  reauthTokens                  CustomerReauthToken[]
  addresses                     CustomerAddress[]
  reviews                       ProductReview[]
  statusId                      Int?
  status                        CustomerStatus?                  @relation(fields: [statusId], references: [id], onDelete: SetNull)
  wishlist                      Wishlist?
  oauthAccounts                 CustomerOAuthAccount[]
  conversations                 Conversation[]                   @relation("ConversationCustomer")
  conversationParticipants      ConversationParticipant[]        @relation("ConversationParticipantCustomer")
  authoredConversationMessages  ConversationMessage[]            @relation("ConversationMessageAuthorCustomer")
}

model CustomerEmailVerificationToken {
  id            Int       @id @default(autoincrement())
  customerId    Int
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  emailSnapshot String
  expiresAt     DateTime
  usedAt        DateTime?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerId])
  @@index([expiresAt])
}

model CustomerOAuthAccount {
  id                Int       @id @default(autoincrement())
  customerId        Int
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  email             String?
  name              String?
  givenName         String?
  familyName        String?
  picture           String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  @@unique([provider, providerAccountId])
  @@index([customerId])
}

model CustomerPhone {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String
  label      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model CustomerSecurityEvent {
  id         Int                       @id @default(autoincrement())
  customerId Int?
  customer   Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  eventType  CustomerSecurityEventType
  channel    String?
  ipAddress  String?
  userAgent  String?
  deviceId   String?
  metadata   Json?
  createdAt  DateTime                  @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model CustomerOtpChallenge {
  id            Int       @id @default(autoincrement())
  customerId    Int
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone         String
  otpHash       String
  otpLength     Int       @default(6)
  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(5)
  channel       String?
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  lastAttemptAt DateTime?
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerId])
  @@index([phone])
  @@index([expiresAt])
  @@index([createdAt])
}

model CustomerReauthToken {
  id         Int                  @id @default(autoincrement())
  customerId Int
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String               @unique
  method     CustomerReauthMethod
  factors    Json?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime             @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

model Wishlist {
  id         Int            @id @default(autoincrement())
  customerId Int            @unique
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  items      WishlistItem[]
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  wishlistId Int
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

// Sales Product
model Product {
  id                        Int                           @id @default(autoincrement())
  name                      String
  productCode               String?
  img                       String?
  description               String?
  specifications            String?
  seoTitle                  String?
  seoDescription            String?
  seoImageUrl               String?
  productCapabilities       Json?
  productConfigSchema       Json?
  categoryId                Int?
  category                  ProductCategory?              @relation(fields: [categoryId], references: [id])
  installationResolutionMode InstallationResolutionMode?
  installationChargeScope   InstallationChargeScope?
  installationPricePresentationMode InstallationPricePresentationMode?
  installServiceProductId   Int?
  installServiceProduct     Product?                      @relation("ProductInstallService", fields: [installServiceProductId], references: [id], onDelete: SetNull)
  productType               ProductType                   @default(PHYSICAL)
  mode                      ProductMode                   @default(SIMPLE)
  calculationStrategy       String                        @default("M2")
  salePrice                 Decimal                       @default(0) @map("precio_venta") @db.Decimal(12, 2)
  costPrice                 Decimal                       @default(0) @map("precio_costo") @db.Decimal(12, 2)
  currency                  String                        @default("UYU")
  unitOfMeasure             SalesUnit                     @default(UNIT)
  isBudgetCalculable        Boolean                       @default(false)
  stock                     Int                           @default(0)
  permanentStock            Boolean                       @default(false)
  status                    Int                           @default(0) // 0=inStock,1=limited,2=outOfStock
  costPerItem               Float?
  bulkDiscountPrice         Float?
  taxRate                   Float?                        @default(22)
  tags                      String[]
  brand                     String?
  vendor                    String?
  published                 Boolean                       @default(true)
  images                    ProductImage[]
  options                   ProductOption[]
  variants                  ProductVariant[]
  wishlistItems             WishlistItem[]
  cmsEntries                CmsEntry[]
  productRelationsFrom      ProductRelation[]               @relation("ProductRelationSource")
  productRelationsTo        ProductRelation[]               @relation("ProductRelationTarget")
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  orderItems                OrderItem[]
  reviews                   ProductReview[]
  installServiceForCategory ProductCategory?              @relation("CategoryInstallService")
  installServiceForProduct  Product[]                     @relation("ProductInstallService")
  priceMatrix               DimensionPriceMatrix[]
  parametricMatrixStaging   ParametricMatrixStaging[]     @relation("ProductParametricMatrixStaging")
  compatibilityRules        ParametricCompatibilityRule[]
  canonicalConfigurations    CanonicalConfiguration[]

  @@index([installServiceProductId])
}

model CanonicalConfiguration {
  id                 Int      @id @default(autoincrement())
  tenantId           String   @default("global")
  baseProductId      Int
  baseProduct        Product  @relation(fields: [baseProductId], references: [id], onDelete: Cascade)
  configurationRules Json
  canonicalName      String
  baseLabel          String?
  slug               String
  indexable          Boolean  @default(true)
  seoTitle           String?
  seoDescription     String?
  searchTerms        String[]
  visibilityRules    Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([baseProductId, indexable])
  @@index([tenantId, indexable])
}

model StandardSize {
  id        Int      @id @default(autoincrement())
  width     Decimal  @db.Decimal(10, 4)
  height    Decimal  @db.Decimal(10, 4)
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([width, height])
  @@index([isActive, sortOrder])
}

model ProductRelation {
  id               Int                 @id @default(autoincrement())
  productId        Int
  product          Product             @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId Int
  relatedProduct   Product             @relation("ProductRelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)
  type             ProductRelationType
  sortOrder        Int                 @default(0)
  isActive         Boolean             @default(true)
  metadata         Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([productId, relatedProductId, type])
