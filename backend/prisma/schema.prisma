  SEPARATE_SERVICE
  NOT_OFFERED
  UNKNOWN
}

enum InstallationChargeScope {
  PER_QUOTE
  MATCH_PRODUCT_QUANTITY
  MATCH_PRODUCT_MEASUREMENTS
}

enum InstallationPricePresentationMode {
  EXACT
  FROM_BASE
  HIDDEN
}

enum ProductAttributeType {
  COLOR
  SIZE
  MATERIAL
}

enum CmsEntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CmsEntryAssetType {
  IMAGE
  VIDEO
  EMBED
}

enum InboxChannelType {
  EMAIL
  WHATSAPP
  MESSENGER
  INSTAGRAM
  SMS
  OTHER
}

enum InboxMessageDirection {
  INBOUND
  OUTBOUND
}

enum InboxMessageEventType {
  CREATED
  FETCHED
  FLAG_UPDATED
  MOVED
  SENT
  SYNCED
  ERROR
}

enum ConversationScope {
  CUSTOMER_PUBLIC
  CUSTOMER_AUTHENTICATED
  ADMIN_INTERNAL
}

enum ConversationRole {
  CUSTOMER_PUBLIC
  CUSTOMER_AUTHENTICATED
  ADMIN_SUPPORT
  ADMIN_SALES
  ADMIN_OPERATIONS
  ADMIN_SUPERVISOR
  SUPERADMIN
}

enum ConversationChannel {
  WEBCHAT
  EMAIL
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  ADMIN_CHAT
}

enum ConversationControlMode {
  AI
  HUMAN
  HYBRID
}

enum ConversationStatus {
  OPEN
  CLOSED
  WAITING_CUSTOMER
  WAITING_INTERNAL
}

enum ConversationParticipantRole {
  CUSTOMER
  OPERATOR
  AGENT
  SYSTEM
}

enum ConversationMessageAuthorType {
  CUSTOMER
  OPERATOR
  AGENT
  SYSTEM
}

enum ConversationMessageKind {
  TEXT
  EMAIL
  IMAGE
  FILE
  SYSTEM_EVENT
  TOOL_RESULT
}

enum ConversationToolCallStatus {
  REQUESTED
  VALIDATED
  REJECTED
  CONFIRMED
  EXECUTED
  FAILED
}

enum ConversationHandoffEventType {
  HUMAN_TAKEOVER
  HUMAN_RELEASE
  AI_SUGGEST_ONLY
  AI_RESUME
  ASSIGNED
  UNASSIGNED
}

enum InboxQueueAssignmentMode {
  MANUAL
  LEAST_LOADED
}

enum KnowledgeSourceType {
  DOCS
  WEB_URL
  BACKEND_DATASET
  ADMIN_CURATED
  CONVERSATION_DERIVED
}

enum KnowledgeDocumentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum KnowledgeDocumentScope {
  CUSTOMER_PUBLIC
  ADMIN_INTERNAL
}

enum KnowledgeCandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KnowledgeRawEventStatus {
  NEW
  PROCESSED
  DISCARDED
}

enum KnowledgeIngestionRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum KnowledgeSuggestionFeedbackOutcome {
  USED
  EDITED
  DISCARDED
}

enum KnowledgeSnapshotStatus {
  BUILDING
  READY
  FAILED
  STALE
}

enum KnowledgeSnapshotEntryType {
  TOPIC_SUMMARY
  APPROVED_RULE
  APPROVED_RESPONSE_PATTERN
  GUARDRAIL_NEGATIVE
  KNOWN_GAP
  OPERATIONAL_NOTE
}

enum KnowledgeSnapshotSourceKind {
  KNOWLEDGE_DOCUMENT
  KNOWLEDGE_CANDIDATE
  KNOWLEDGE_RAW_EVENT
  KNOWLEDGE_CONVERSATION_BUNDLE
  KNOWLEDGE_NEGATIVE_EXAMPLE
  KNOWLEDGE_FEEDBACK
}

enum KnowledgeSnapshotSourceRole {
  PRIMARY_SUPPORT
  SECONDARY_SUPPORT
  GUARDRAIL
  COUNTEREXAMPLE
  PENDING_SIGNAL
}

enum KnowledgeConversationBundleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KnowledgeNegativeExampleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KnowledgeNegativeExampleSourceKind {
  REJECTED_CANDIDATE
  DISCARDED_FEEDBACK
  MANUAL
}

enum KnowledgeDerivedArtifactType {
  TOPIC_TAXONOMY
  QUOTE_PROFILE_HINTS
  MEASUREMENT_CARRIER_TERMS
  KEYWORD_LEXICON
}

enum KnowledgeDerivedArtifactStatus {
  ACTIVE
  DISABLED
  STALE
}

enum EmailCategory {
  ORDERS
  PAYMENTS
  AUTH
}

enum EmailRecipientType {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum EmailLogStatus {
  QUEUED
  SENT
  FAILED
  RETRYING
}

enum EmailTemplateVariant {
  CUSTOMER
  ADMIN
}

enum NotificationEventType {
  ORDER_RECEIVED
  PAYMENT_RECEIVED
  ORDER_STATUS_CHANGED
}

enum NotificationAudience {
  CUSTOMER
  ADMIN
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum CustomerSecurityEventType {
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETED
  PASSWORD_RESET_FAILED
  PASSWORD_CHANGE
  PASSWORD_CHANGE_FAILED
  OTP_SENT
  OTP_VERIFIED
  OTP_FAILED
  REAUTH_STARTED
  REAUTH_COMPLETED
  REAUTH_FAILED
  SESSION_REVOKED
}

enum CustomerReauthMethod {
  PASSWORD
  GOOGLE
  OTP
}

enum PasswordResetChannel {
  EMAIL
  PHONE
  GOOGLE
}

// Notifications
model Notification {
  id                  Int                        @id @default(autoincrement())
  eventType           NotificationEventType?
  audience            NotificationAudience?
  channel             NotificationChannel?
  deliveryStatus      NotificationDeliveryStatus @default(PENDING)
  recipientId         Int?
  recipient           User?                      @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  customerId          Int?
  customer            Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId             Int?
  order               Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId           Int?
  payment             Payment?                   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  title               String?
  body                String?
  metadata            Json?
  idempotencyKey      String?                    @unique(map: "notification_idempotency_key_unique")
  readAt              DateTime?
  readed              Boolean                    @default(false)
  legacyTarget        String?                    @map("target")
  legacyDescription   String?                    @map("description")
  legacyType          Int                        @default(0) @map("type")
  legacyImage         String?                    @map("image")
  legacyLocation      String?                    @map("location")
  legacyLocationLabel String?                    @map("locationLabel")
  legacyStatus        String?                    @map("status")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([recipientId, readAt], map: "notification_recipient_read_at_idx")
  @@index([customerId, readAt], map: "notification_customer_read_at_idx")
  @@index([eventType, audience, channel], map: "notification_event_audience_channel_idx")
  @@index([customerId, audience, createdAt], map: "notification_customer_audience_created_at_idx")
  @@index([recipientId, audience, createdAt], map: "notification_recipient_audience_created_at_idx")
  @@index([orderId, id], map: "notification_order_id_id_idx")
}

model NotificationSetting {
  id              Int                   @id @default(autoincrement())
  eventType       NotificationEventType
  audience        NotificationAudience
  channel         NotificationChannel
  enabled         Boolean               @default(true)
  roles           String[]              @default([])
  templateKey     String?
  localeOverrides Json?
  emailSubject    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([eventType, audience, channel], map: "notification_settings_event_channel_unique")
}

// Users and Auth
model User {
  id                             Int                        @id @default(autoincrement())
  name                           String?
  lastName                       String?
  email                          String                     @unique
  img                            String?
  role                           Role                       @default(USER)
  capabilityGroups               UserCapabilityGroup[]      @default([])
  directCapabilities             UserCapability[]           @default([])
  lang                           String                     @default("en")
  country                        String?
  countryCode                    String?
  city                           String?
  passwordHash                   String
  createdAt                      DateTime                   @default(now())
  updatedAt                      DateTime                   @updatedAt
  // relations
  createdTasks                   Task[]
  taskAssignees                  TaskAssignee[]
  events                         CalendarEvent[]
  notifications                  Notification[]
  activityTicketMembers          ActivityTicketMember[]
  calendarComments               CalendarEventComment[]
  activities                     UserActivity[]
  devices                        UserDevice[]
  convertedOrders                Order[]                    @relation("OrderConvertedBy")
  assignedProductionOrders       ProductionOrder[]          @relation("ProductionOrderAssignedTo")
  passwordResetTokens            PasswordResetToken[]
  assignedConversations          Conversation[]             @relation("ConversationAssignedOperator")
  conversationParticipants       ConversationParticipant[]  @relation("ConversationParticipantUser")
  authoredConversationMessages   ConversationMessage[]      @relation("ConversationMessageAuthorUser")
  conversationHandoffEvents      ConversationHandoffEvent[] @relation("ConversationHandoffActorUser")
  requestedConversationToolCalls ConversationToolCall[]     @relation("ConversationToolRequestedByUser")
  conversationReadStates         ConversationReadState[]
  inboxQueueAssignments          InboxQueueUserAssignment[] @relation("InboxQueueAssignedUser")
  authoredKnowledgeDocuments     KnowledgeDocument[]        @relation("KnowledgeDocumentAuthoredByUser")
  approvedKnowledgeDocuments     KnowledgeDocument[]        @relation("KnowledgeDocumentApprovedByUser")
  createdKnowledgeCandidates     KnowledgeCandidate[]       @relation("KnowledgeCandidateCreatedByUser")
  reviewedKnowledgeCandidates    KnowledgeCandidate[]       @relation("KnowledgeCandidateReviewedByUser")
  createdKnowledgeIngestionRuns  KnowledgeIngestionRun[]    @relation("KnowledgeIngestionRunCreatedByUser")
  knowledgeSuggestionFeedbacks   KnowledgeSuggestionFeedback[] @relation("KnowledgeSuggestionFeedbackActorUser")
  generatedKnowledgeSnapshots    KnowledgeSnapshot[]        @relation("KnowledgeSnapshotGeneratedByUser")
  createdKnowledgeConversationBundles KnowledgeConversationBundle[] @relation("KnowledgeConversationBundleCreatedByUser")
  reviewedKnowledgeConversationBundles KnowledgeConversationBundle[] @relation("KnowledgeConversationBundleReviewedByUser")
  createdKnowledgeNegativeExamples KnowledgeNegativeExample[] @relation("KnowledgeNegativeExampleCreatedByUser")
  reviewedKnowledgeNegativeExamples KnowledgeNegativeExample[] @relation("KnowledgeNegativeExampleReviewedByUser")
}

model UserDevice {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint   String         @unique
  displayName   String?
  userAgent     String?
  location      String?
  lastIpAddress String?
  deviceType    String?
  firstSeenAt   DateTime       @default(now())
  lastSeenAt    DateTime       @default(now())
  activities    UserActivity[]
}

model UserActivity {
  id          Int              @id @default(autoincrement())
  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        UserActivityType
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  deviceId    Int?
  device      UserDevice?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  performedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())
}

// CRM Customer
model Customer {
  id                            Int                              @id @default(autoincrement())
  name                          String
  firstName                     String?
  lastName                      String?
  email                         String?                          @unique
  emailVerifiedAt               DateTime?
  img                           String?
  location                      String?
  title                         String?
  phoneNumber                   String?                          @unique
  passwordHash                  String?
  storefrontDefaultPasswordHash String?
  passwordAlgorithm             String?                          @default("bcrypt")
  passwordAlgVersion            Int?                             @default(12)
  passwordUpdatedAt             DateTime?
  storefrontSessionVersion      Int                              @default(1)
  birthday                      DateTime?
  facebook                      String?
  twitter                       String?
  pinterest                     String?
  linkedIn                      String?
  phones                        CustomerPhone[]
  preferredLocale               String                           @default("es")
  createdAt                     DateTime                         @default(now())
  updatedAt                     DateTime                         @updatedAt
  orders                        Order[]
  notifications                 Notification[]
  passwordResetTokens           PasswordResetToken[]
  emailVerificationTokens       CustomerEmailVerificationToken[]
  securityEvents                CustomerSecurityEvent[]
  otpChallenges                 CustomerOtpChallenge[]
  reauthTokens                  CustomerReauthToken[]
  addresses                     CustomerAddress[]
  statusId                      Int?
  status                        CustomerStatus?                  @relation(fields: [statusId], references: [id], onDelete: SetNull)
  wishlist                      Wishlist?
  oauthAccounts                 CustomerOAuthAccount[]
  conversations                 Conversation[]                   @relation("ConversationCustomer")
  conversationParticipants      ConversationParticipant[]        @relation("ConversationParticipantCustomer")
  authoredConversationMessages  ConversationMessage[]            @relation("ConversationMessageAuthorCustomer")
}

model CustomerEmailVerificationToken {
  id            Int       @id @default(autoincrement())
  customerId    Int
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  emailSnapshot String
  expiresAt     DateTime
  usedAt        DateTime?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerId])
  @@index([expiresAt])
}

model CustomerOAuthAccount {
  id                Int       @id @default(autoincrement())
  customerId        Int
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  email             String?
  name              String?
  givenName         String?
  familyName        String?
  picture           String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  @@unique([provider, providerAccountId])
  @@index([customerId])
}

model CustomerPhone {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String
  label      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model CustomerSecurityEvent {
  id         Int                       @id @default(autoincrement())
  customerId Int?
  customer   Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  eventType  CustomerSecurityEventType
  channel    String?
  ipAddress  String?
  userAgent  String?
  deviceId   String?
  metadata   Json?
  createdAt  DateTime                  @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model CustomerOtpChallenge {
  id            Int       @id @default(autoincrement())
  customerId    Int
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone         String
  otpHash       String
  otpLength     Int       @default(6)
  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(5)
  channel       String?
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  lastAttemptAt DateTime?
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerId])
  @@index([phone])
  @@index([expiresAt])
  @@index([createdAt])
}

model CustomerReauthToken {
  id         Int                  @id @default(autoincrement())
  customerId Int
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String               @unique
  method     CustomerReauthMethod
  factors    Json?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime             @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

model Wishlist {
  id         Int            @id @default(autoincrement())
  customerId Int            @unique
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  items      WishlistItem[]
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  wishlistId Int
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

// Sales Product
model Product {
  id                        Int                           @id @default(autoincrement())
  name                      String
  productCode               String?
  img                       String?
  description               String?
  specifications            String?
  categoryId                Int?
  category                  ProductCategory?              @relation(fields: [categoryId], references: [id])
  installationResolutionMode InstallationResolutionMode?
  installationChargeScope   InstallationChargeScope?
  installationPricePresentationMode InstallationPricePresentationMode?
  installServiceProductId   Int?
  installServiceProduct     Product?                      @relation("ProductInstallService", fields: [installServiceProductId], references: [id], onDelete: SetNull)
  productType               ProductType                   @default(PHYSICAL)
  mode                      ProductMode                   @default(SIMPLE)
  salePrice                 Decimal                       @default(0) @map("precio_venta") @db.Decimal(12, 2)
  costPrice                 Decimal                       @default(0) @map("precio_costo") @db.Decimal(12, 2)
  currency                  String                        @default("UYU")
  unitOfMeasure             SalesUnit                     @default(UNIT)
  stock                     Int                           @default(0)
  permanentStock            Boolean                       @default(false)
  status                    Int                           @default(0) // 0=inStock,1=limited,2=outOfStock
  costPerItem               Float?
  bulkDiscountPrice         Float?
  taxRate                   Float?                        @default(22)
  tags                      String[]
  brand                     String?
  vendor                    String?
  published                 Boolean                       @default(true)
  images                    ProductImage[]
  options                   ProductOption[]
  variants                  ProductVariant[]
  wishlistItems             WishlistItem[]
  cmsEntries                CmsEntry[]
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  orderItems                OrderItem[]
  installServiceForCategory ProductCategory?              @relation("CategoryInstallService")
  installServiceForProduct  Product[]                     @relation("ProductInstallService")
  priceMatrix               DimensionPriceMatrix[]
  parametricMatrixStaging   ParametricMatrixStaging[]     @relation("ProductParametricMatrixStaging")
  compatibilityRules        ParametricCompatibilityRule[]

  @@index([installServiceProductId])
}

model ProductImage {
  id        Int             @id @default(autoincrement())
  productId Int
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId Int?
  variant   ProductVariant? @relation("ProductVariantImages", fields: [variantId], references: [id], onDelete: Cascade)
  name      String?
  img       String
  sortOrder Int             @default(0)

  @@index([productId, variantId])
}

model ProductOption {
  id        Int                  @id @default(autoincrement())
  productId Int
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      ProductAttributeType
  name      String
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  values    ProductOptionValue[]

  @@unique([productId, type])
  @@index([productId])
}

model ProductOptionValue {
  id         Int                       @id @default(autoincrement())
  optionId   Int
  option     ProductOption             @relation(fields: [optionId], references: [id], onDelete: Cascade)
  code       String
  label      String
  value      String?
  colorHex   String?
  imageUrl   String?
  imageAlt   String?
  sortOrder  Int                       @default(0)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  selections ProductVariantSelection[]

  @@unique([optionId, code])
  @@index([optionId])
}

model ProductVariant {
  id               Int                       @id @default(autoincrement())
  productId        Int
  product          Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  key              String
  sku              String?
  barcode          String?
  label            String?
  salePrice        Decimal?                  @db.Decimal(12, 2)
  costPrice        Decimal?                  @db.Decimal(12, 2)
  stock            Int?
  permanentStock   Boolean?
  isActive         Boolean                   @default(true)
  inheritSalePrice Boolean                   @default(true)
  inheritCostPrice Boolean                   @default(true)
  inheritStock     Boolean                   @default(true)
  inheritSku       Boolean                   @default(true)
  inheritImages    Boolean                   @default(true)
  attributes       Json                      @default("{}")
  combinationKey   String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  images           ProductImage[]            @relation("ProductVariantImages")
  selections       ProductVariantSelection[]
  orderItems       OrderItem[]

  @@unique([productId, combinationKey])
  @@unique([productId, key])
  @@index([productId])
  @@index([productId, isActive])
}

model ProductVariantSelection {
  variantId     Int
  optionValueId Int
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model ProductCategory {
  id                      Int               @id @default(autoincrement())
  name                    String            @unique
  description             String?
  image                   String?
  parentId                Int?
  parent                  ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children                ProductCategory[] @relation("CategoryHierarchy")
  products                Product[]
  cmsEntries              CmsEntry[]
  installationResolutionMode InstallationResolutionMode?
  installationChargeScope   InstallationChargeScope?
  installationPricePresentationMode InstallationPricePresentationMode?
  installServiceProductId Int?
  installServiceProduct   Product?          @relation("CategoryInstallService", fields: [installServiceProductId], references: [id], onDelete: SetNull)

  @@unique([installServiceProductId])
  @@index([parentId])
}

model CmsSection {
  id          Int        @id @default(autoincrement())
  key         String     @unique
  name        String
  description String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  entries     CmsEntry[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive, sortOrder])
}

model CmsEntry {
  id           Int              @id @default(autoincrement())
  sectionId    Int
  section      CmsSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug         String?
  title        String
  subtitle     String?
  description  String?
  payload      Json?
  locale       String           @default("es")
  status       CmsEntryStatus   @default(DRAFT)
  priority     Int              @default(0)
  isActive     Boolean          @default(true)
  publishedAt  DateTime?
  startsAt     DateTime?
  endsAt       DateTime?
  thumbnailUrl String?
  ctaLabel     String?
  ctaUrl       String?
  productId    Int?
  product      Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId   Int?
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assets       CmsEntryAsset[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([sectionId, locale, slug])
  @@index([sectionId, status, isActive, priority])
  @@index([productId])
  @@index([categoryId])
  @@index([publishedAt])
}

model CmsEntryAsset {
  id          Int               @id @default(autoincrement())
  entryId     Int
