                  {
                    "type": "text",
                    "value": "Toldos y Cerramientos en PVC"
                  }
                ],
                "attributes": {
                  "className": "text-center"
                }
              },
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Los "
                  },
                  {
                    "tag": "strong",
                    "type": "element",
                    "children": [
                      {
                        "type": "text",
                        "value": "Toldos"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": " y los "
                  },
                  {
                    "tag": "strong",
                    "type": "element",
                    "children": [
                      {
                        "type": "text",
                        "value": "Cerramientos en PVC"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": " son soluciones ideales para proteger espacios exteriores del sol, viento y lluvia, ofreciendo confort y estética a terrazas, patios y jardines."
                  }
                ]
              },
              {
                "tag": "h2",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Toldo de Brazo Invisible"
                  }
                ]
              },
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Estos toldos proporcionan "
