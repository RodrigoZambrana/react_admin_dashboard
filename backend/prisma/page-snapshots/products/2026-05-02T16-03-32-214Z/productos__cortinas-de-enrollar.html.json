      "sortOrder": 2,
      "visible": true,
      "settings": {
        "title": "Preguntas frecuentes",
        "description": "Respuestas cortas para avanzar con más seguridad."
      },
      "createdAt": "2026-05-02T16:03:12.874Z",
      "updatedAt": "2026-05-02T16:03:12.874Z",
      "blocks": [
        {
          "id": 3627,
          "sectionId": 2686,
          "type": "FAQ_ITEM",
          "key": "cortinas-enrollar-faq-faq-1",
          "name": "¿Qué diferencia hay entre aluminio y PVC?",
          "sortOrder": 0,
          "visible": true,
          "content": {
            "question": "¿Se instalan sin obra?",
            "answerRichText": [
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Sí, en muchos casos se instalan sin albañilería y se coordinan según el frente."
                  }
                ]
              }
            ]
          },
          "mediaId": null,
          "createdAt": "2026-05-02T16:03:12.874Z",
          "updatedAt": "2026-05-02T16:03:12.874Z",
          "media": null
        },
        {
          "id": 3628,
          "sectionId": 2686,
          "type": "FAQ_ITEM",
          "key": "cortinas-enrollar-faq-faq-2",
          "name": "¿Se pueden reparar sin cambiar toda la cortina?",
          "sortOrder": 1,
          "visible": true,
          "content": {
            "question": "¿Pueden ser manuales o motorizadas?",
            "answerRichText": [
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Sí, según el producto y el tipo de uso."
                  }
                ]
              }
            ]
          },
          "mediaId": null,
          "createdAt": "2026-05-02T16:03:12.875Z",
          "updatedAt": "2026-05-02T16:03:12.875Z",
          "media": null
        },
        {
          "id": 3629,
          "sectionId": 2686,
          "type": "FAQ_ITEM",
          "key": "cortinas-enrollar-faq-faq-3",
          "name": "¿Sirven para casas y comercios?",
          "sortOrder": 2,
          "visible": true,
          "content": {
            "question": "¿Cuándo conviene aluminio?",
            "answerRichText": [
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Cuando necesitás más robustez, una respuesta más firme y mejor comportamiento en frentes expuestos."
                  }
                ]
              }
            ]
          },
          "mediaId": null,
          "createdAt": "2026-05-02T16:03:12.875Z",
          "updatedAt": "2026-05-02T16:03:12.875Z",
          "media": null
        },
        {
          "id": 3630,
          "sectionId": 2686,
          "type": "FAQ_ITEM",
          "key": "cortinas-enrollar-faq-faq-4",
          "name": "¿Puedo pedir asesoramiento antes de decidir el material?",
          "sortOrder": 3,
          "visible": true,
          "content": {
            "question": "¿Cuándo conviene PVC?",
            "answerRichText": [
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Cuando priorizás practicidad, mantenimiento simple y un costo más accesible."
                  }
                ]
              }
            ]
          },
          "mediaId": null,
          "createdAt": "2026-05-02T16:03:12.876Z",
          "updatedAt": "2026-05-02T16:03:12.876Z",
          "media": null
        }
      ]
