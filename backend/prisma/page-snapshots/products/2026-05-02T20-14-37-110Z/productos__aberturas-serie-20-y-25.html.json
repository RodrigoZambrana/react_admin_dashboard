          "key": "productos-aberturas-serie-20-y-25-html-deepening-copy",
          "name": "Detalles técnicos y de uso",
          "sortOrder": 0,
          "visible": true,
          "content": {
            "richText": [
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Serie 20 y 25 resuelve ventanas y puertas ventana de uso cotidiano, con medidas frecuentes y una propuesta más accesible."
                  }
                ]
              },
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Es una base sólida para recambio o instalación nueva cuando no se necesita la complejidad de una línea de alta prestación."
                  }
                ]
              },
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Si el frente es más exigente, la comparación con Probba, Gala o Summa ayuda a elegir mejor."
                  }
                ]
              }
            ]
          },
