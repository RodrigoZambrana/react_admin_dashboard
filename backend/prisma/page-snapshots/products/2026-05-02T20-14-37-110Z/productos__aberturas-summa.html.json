            "richText": [
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Summa combina más transparencia, más confort, más seguridad y más practicidad, con hojas de hasta 3 metros de altura según la propuesta del fabricante."
                  }
                ]
              },
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "La ficha local muestra además variantes como Summa Alzante y Summa Comfort RPT, pensadas para sumar performance en proyectos más exigentes."
                  }
                ]
              },
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "También aparecen terminaciones disponibles y tipologías corredizas con DVH, lo que ayuda a elegir mejor según obra y nivel de prestación."
                  }
                ]
              }
            ]
