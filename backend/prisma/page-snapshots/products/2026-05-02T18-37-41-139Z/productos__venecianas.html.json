          "content": {
            "question": "¿Conviene 16 mm o 25 mm?",
            "answerRichText": [
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "16 mm suele verse más liviana y 25 mm suele tener más presencia visual. La elección depende del frente y del ambiente."
                  }
                ]
              }
            ]
          },
