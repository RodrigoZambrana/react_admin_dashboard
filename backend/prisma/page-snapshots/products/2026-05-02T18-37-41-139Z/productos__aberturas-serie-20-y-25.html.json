          "key": "productos-aberturas-serie-20-y-25-html-copy",
          "name": "Contenido editorial",
          "sortOrder": 0,
          "visible": true,
          "content": {
            "richText": [
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Se recomienda cuando necesitás una solución funcional, de medidas habituales y con una relación precio-prestación más accesible."
                  }
                ]
              },
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Es una buena elección para ventanas y puertas ventana de uso cotidiano, especialmente cuando no se necesita DVH."
                  }
                ]
              },
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "Para frentes grandes o proyectos que buscan más confort, conviene comparar con Probba, Gala o Summa."
                  }
                ]
              },
              {
                "tag": "p",
                "type": "element",
                "children": [
                  {
                    "type": "text",
                    "value": "En puertas ventana o ventanas grandes, superiores a 1.50 x 1.50, suele recomendarse Serie 25."
                  }
                ]
              }
            ]
          },
