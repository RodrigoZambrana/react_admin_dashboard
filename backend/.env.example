# Backend environment variables
NODE_ENV=development
PORT=4000
# Ajusta a otro slug (por ejemplo "urucortinas") para seleccionar la variante del cliente
CLIENT_SLUG=core

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/react_admin_dashboard?schema=public
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=react_admin_dashboard
DEFAULT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5174

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth
JWT_SECRET=
COOKIE_SECRET=
SESSION_TTL_HOURS=168

# Storefront Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/storefront/auth/google/callback

# reCAPTCHA (set *_ENABLED to true only when the keys are defined)
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=

# Seed helpers
DEFAULT_USER_TEMP_PASSWORD=TempPass@123!
# Generic storefront customer password (used for legacy customers without credentials)
STOREFRONT_GENERIC_CUSTOMER_PASSWORD=Storefront@2024
RUN_PRISMA_SEED_ON_BOOT=false
ENABLE_DEMO_SEED=false
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Local Admin
SEED_SUPERADMIN_FIRST_NAME=
SEED_SUPERADMIN_LAST_NAME=
SEED_USER_PASSWORD=

# Other toggles
PRISMA_APPLY_MIGRATIONS=true
SENTRY_DSN=
INBOX_EMAIL_IMAP_HOST=
INBOX_EMAIL_IMAP_PORT=
INBOX_EMAIL_IMAP_SECURITY=
INBOX_EMAIL_SMTP_HOST=
INBOX_EMAIL_SMTP_PORT=
INBOX_EMAIL_SMTP_SECURITY=
INBOX_EMAIL_USER=
INBOX_EMAIL_PASSWORD=
INBOX_EMAIL_DEFAULT_FROM=
INBOX_EMAIL_DEFAULT_NAME=
INBOX_EMAIL_DISPLAY_NAME=
INBOX_EMAIL_MAX_ATTACHMENT_MB=
INBOX_EMAIL_RATE_PER_MINUTE=
INBOX_EMAIL_POLL_INTERVAL_MS=
INBOX_EMAIL_POLL_BATCH_SIZE=
PAYMENTS_PROVIDER=mercadopago
