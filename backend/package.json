    "bcrypt": "^6.0.0",
    "bullmq": "^4.17.0",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "csv-parse": "^6.2.1",
    "handlebars": "^4.7.8",
    "html-to-text": "^9.0.5",
    "imapflow": "^1.2.16",
    "ioredis": "^5.10.1",
    "jose": "^5.9.3",
    "mailparser": "^3.9.4",
    "mammoth": "^1.12.0",
    "mercadopago": "^2.12.0",
    "nodemailer": "^8.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.0",
    "prisma": "^6.19.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reflect-metadata": "^0.2.2",
