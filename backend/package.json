{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/src/main",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "seed": "ts-node --project tsconfig.seed.json --transpile-only prisma/seed.ts",
    "bootstrap:fresh:local": "sh scripts/bootstrap-fresh-local-db.sh",
    "regression:prepare": "sh scripts/prepare-regression-state.sh --dry-run",
    "regression:prepare:apply": "sh scripts/prepare-regression-state.sh --confirm",
    "restore:catalog:slice": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/restore-product-slice-via-import.ts --dry-run",
    "restore:catalog:slice:apply": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/restore-product-slice-via-import.ts --confirm",
    "sync:urucortinas:installation": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/sync-urucortinas-installation-config.ts --dry-run",
    "sync:urucortinas:installation:apply": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/sync-urucortinas-installation-config.ts --confirm",
    "knowledge:reindex:chunks": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/reindex-knowledge-chunks.ts --dry-run",
    "knowledge:reindex:chunks:apply": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/reindex-knowledge-chunks.ts --confirm",
    "cms:import:legacy-html": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/import-legacy-html-site.ts",
    "cms:seed:public-content": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/seed-urucortinas-public-cms-content.ts",
    "cms:refine-commercial-hub": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/refine-commercial-hub-content.ts",
    "analytics:import-ga4-baseline": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/import-ga4-baseline.ts",
    "analytics:import-csv-baseline": "ts-node --project tsconfig.json scripts/import-analytics-csv-baseline.ts",
    "analytics:baseline-check": "ts-node --project tsconfig.json scripts/analytics-baseline-check.ts",
    "analytics:sync-ga4-report-parity": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/sync-ga4-report-parity.ts",
    "analytics:health": "ts-node --project tsconfig.json scripts/analytics-health.ts",
    "analytics:health:json": "ts-node --project tsconfig.json scripts/analytics-health.ts --json",
    "analytics:health:monitor": "ts-node --project tsconfig.json scripts/analytics-health-monitor.ts",
    "analytics:health:monitor:once": "ts-node --project tsconfig.json scripts/analytics-health-monitor.ts --once",
    "analytics:health:digest": "ts-node --project tsconfig.json scripts/analytics-health-monitor.ts --digest",
    "analytics:worker": "node dist/src/analytics/analytics.worker.js",
    "analytics:worker:dev": "ts-node --project tsconfig.json src/analytics/analytics.worker.ts",
    "lint:hardcoded-content": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/scan-hardcoded-content.ts",
    "baseline:export": "ts-node --project tsconfig.seed.json --transpile-only scripts/export-baseline-fixture.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:resolve:consolidated-baseline": "prisma migrate resolve --applied 20260428170000_consolidated_baseline",
    "prisma:resolve:squashed-baseline": "prisma migrate resolve --applied 20260428170000_consolidated_baseline",
    "prisma:seed": "ts-node --project tsconfig.seed.json --transpile-only prisma/seed.ts",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "reset-admin": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/reset-admin.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
