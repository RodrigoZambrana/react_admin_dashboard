    {
      "id": "ai-runtime-smoke",
      "name": "AI Runtime Smoke",
      "description": "Valida Redis y los servicios base del stack AI levantados por Docker.",
      "kind": "quality",
      "cwd": ".",
      "steps": [
        {
          "cwd": ".",
          "command": [
            "docker",
            "compose",
            "-f",
            "deploy/docker-compose.dev.yml",
            "-f",
            "deploy/docker-compose.channel-adapter.yml",
            "--profile",
            "ai",
            "exec",
            "-T",
            "redis",
            "redis-cli",
            "ping"
          ]
        },
        {
          "cwd": ".",
          "command": [
            "curl",
            "-fsS",
            "http://127.0.0.1:4110/health"
          ]
        },
        {
          "cwd": ".",
          "command": [
            "docker",
            "compose",
            "-f",
            "deploy/docker-compose.dev.yml",
            "-f",
            "deploy/docker-compose.channel-adapter.yml",
            "--profile",
            "ai",
            "exec",
            "-T",
            "channel-adapter",
            "node",
            "-e",
            "fetch('http://127.0.0.1:4200/health').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"
          ]
        },
        {
          "cwd": ".",
          "command": [
            "docker",
            "compose",
            "-f",
            "deploy/docker-compose.dev.yml",
            "-f",
            "deploy/docker-compose.channel-adapter.yml",
            "--profile",
            "ai",
            "exec",
            "-T",
            "channel-adapter",
            "node",
            "-e",
            "fetch('http://127.0.0.1:4200/channels').then((response) => response.text()).then((body) => { if (!body.trim()) process.exit(1); process.stdout.write(body); }).catch(() => process.exit(1))"
          ]
        }
      ],
      "estimatedMinutes": 1,
      "tags": [
        "ai",
        "redis",
        "docker",
        "smoke"
      ]
    },
