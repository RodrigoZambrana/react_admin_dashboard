# syntax=docker/dockerfile:1

FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat curl
COPY package*.json ./
RUN npm ci --legacy-peer-deps

FROM deps AS build
WORKDIR /app
ENV NODE_ENV=production
ARG NEXT_PUBLIC_STOREFRONT_API_URL
ARG STOREFRONT_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_STOREFRONT_HOME_PATH
ARG NEXT_PUBLIC_GOOGLE_BUTTON_ENABLED
ARG NEXT_PUBLIC_STORE_LOCALE
ARG NEXT_PUBLIC_MP_PUBLIC_KEY
ARG NEXT_PUBLIC_MP_COUNTRY
ARG NEXT_PUBLIC_MP_SUCCESS_URL
ARG NEXT_PUBLIC_MP_FAILURE_URL
ARG NEXT_PUBLIC_ENABLE_STOREFRONT_MOCKS
ARG ENABLE_STOREFRONT_MOCKS
ENV NEXT_PUBLIC_STOREFRONT_API_URL=${NEXT_PUBLIC_STOREFRONT_API_URL}
ENV STOREFRONT_API_URL=${STOREFRONT_API_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_STOREFRONT_HOME_PATH=${NEXT_PUBLIC_STOREFRONT_HOME_PATH}
ENV NEXT_PUBLIC_GOOGLE_BUTTON_ENABLED=${NEXT_PUBLIC_GOOGLE_BUTTON_ENABLED}
ENV NEXT_PUBLIC_STORE_LOCALE=${NEXT_PUBLIC_STORE_LOCALE}
ENV NEXT_PUBLIC_MP_PUBLIC_KEY=${NEXT_PUBLIC_MP_PUBLIC_KEY}
ENV NEXT_PUBLIC_MP_COUNTRY=${NEXT_PUBLIC_MP_COUNTRY}
ENV NEXT_PUBLIC_MP_SUCCESS_URL=${NEXT_PUBLIC_MP_SUCCESS_URL}
ENV NEXT_PUBLIC_MP_FAILURE_URL=${NEXT_PUBLIC_MP_FAILURE_URL}
ENV NEXT_PUBLIC_ENABLE_STOREFRONT_MOCKS=${NEXT_PUBLIC_ENABLE_STOREFRONT_MOCKS}
ENV ENABLE_STOREFRONT_MOCKS=${ENABLE_STOREFRONT_MOCKS}
COPY . .
RUN npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
RUN apk add --no-cache libc6-compat curl
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=build /app/public ./public
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/package.json ./package.json
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -f http://127.0.0.1:3000/api/health || exit 1
CMD ["node", "server.js"]
