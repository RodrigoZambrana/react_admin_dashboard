NODE_ENV=production
PORT=3000
CLIENT_SLUG=core
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/react_admin_dashboard?schema=public
DEFAULT_ALLOWED_ORIGINS=https://admin.example.com
ALLOWED_ORIGINS=https://admin.example.com
NEXT_PUBLIC_SITE_URL=https://admin.example.com

JWT_SECRET=__set_prod_jwt_secret__
COOKIE_SECRET=__set_prod_cookie_secret__
SESSION_TTL_HOURS=168
CUSTOMER_PASSWORD_RESET_TTL_MS=1800000
CUSTOMER_PASSWORD_RESET_WINDOW_MS=3600000
CUSTOMER_PASSWORD_RESET_MAX_PER_IDENTIFIER=3
CUSTOMER_PASSWORD_RESET_MAX_PER_IP=10
CUSTOMER_PASSWORD_OTP_TTL_MS=300000
CUSTOMER_PASSWORD_OTP_MAX_ATTEMPTS=5
CUSTOMER_PASSWORD_OTP_MAX_PER_PHONE=3
CUSTOMER_PASSWORD_OTP_MAX_PER_IP=10
CUSTOMER_PASSWORD_OTP_RESEND_COOLDOWN_MS=60000
CUSTOMER_REAUTH_TOKEN_TTL_MS=600000

RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://admin.example.com/api/storefront/auth/google/callback
STOREFRONT_COOKIE_SECURE=true
STOREFRONT_COOKIE_SAMESITE=lax
STOREFRONT_COOKIE_DOMAIN=

DEFAULT_USER_TEMP_PASSWORD=__set_prod_temp_password__
STOREFRONT_GENERIC_CUSTOMER_PASSWORD=__set_storefront_customer_password__
RUN_PRISMA_SEED_ON_BOOT=false
ENABLE_DEMO_SEED=false
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME="Prod Admin"
SEED_SUPERADMIN_FIRST_NAME=
SEED_SUPERADMIN_LAST_NAME=
SEED_USER_PASSWORD=

PRISMA_APPLY_MIGRATIONS=true
PRISMA_QUERY_TIMEOUT_MS=20000
PARAMETRIC_IMPORT_TIMEOUT_MS=120000
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

EMAIL_PROVIDER=SMTP
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_ALLOW_INVALID_CERTS=false
EMAIL_FROM_DEFAULT=no-reply@example.com
EMAIL_FROM_NAME_DEFAULT="Sistema Administrativo"

INBOX_EMAIL_IMAP_HOST=
INBOX_EMAIL_IMAP_PORT=
INBOX_EMAIL_IMAP_SECURITY=
