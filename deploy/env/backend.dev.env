NODE_ENV=development
PORT=4000
# Ajusta a otro slug (por ejemplo "urucortinas") para desarrollar con una variante específica
CLIENT_SLUG=core
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/react_admin_dashboard?schema=public
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=react_admin_dashboard
DEFAULT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://0.0.0.0:3000
JWT_SECRET=dev-secret
SESSION_TTL_HOURS=24
COOKIE_SECRET=dev-cookie-secret
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5174,http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
