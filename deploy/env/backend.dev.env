NODE_ENV=development
PORT=4000
# Cambia a "core" para desarrollar sobre la variante general
CLIENT_SLUG=urucortinas
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/react_admin_dashboard?schema=public
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/react_admin_dashboard?schema=public
JWT_SECRET=dev-secret
SESSION_TTL_HOURS=24
COOKIE_SECRET=dev-cookie-secret
ALLOWED_ORIGINS=http://localhost:8080, http://localhost:5174
# Password temporal asignada a usuarios creados manualmente (no aplica al superadmin seed)
DEFAULT_USER_TEMP_PASSWORD=TempPass@123!
RECAPTCHA_SECRET_KEY=6LejMNQrAAAAALMJpL_nnU3fH3Kxtr8fvW2tWaqS
RECAPTCHA_ENABLED=false
PRISMA_APPLY_MIGRATIONS=true
SENTRY_DSN=
RUN_PRISMA_SEED_ON_BOOT=false
ENABLE_DEMO_SEED=false
# Credenciales del usuario superadmin creado automáticamente en el seed de desarrollo
SEED_SUPERADMIN_EMAIL=admin@example.com
# Debe coincidir con la contraseña predeterminada del formulario de inicio de sesión en el frontend
SEED_SUPERADMIN_PASSWORD=Admin@123!
SEED_SUPERADMIN_NAME=Local Admin
SEED_SUPERADMIN_FIRST_NAME=
SEED_SUPERADMIN_LAST_NAME=
SEED_USER_PASSWORD=
