NODE_ENV=development
PORT=4000
CLIENT_SLUG=urucortinas
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/react_admin_dashboard?schema=public
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=react_admin_dashboard
DEFAULT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://0.0.0.0:3000
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
KNOWLEDGE_DOCS_PATH=/docs

JWT_SECRET=local-dev-jwt-secret-change-me
COOKIE_SECRET=local-dev-cookie-secret-change-me
SESSION_TTL_HOURS=24
CUSTOMER_PASSWORD_RESET_TTL_MS=1800000
CUSTOMER_PASSWORD_RESET_WINDOW_MS=3600000
CUSTOMER_PASSWORD_RESET_MAX_PER_IDENTIFIER=3
CUSTOMER_PASSWORD_RESET_MAX_PER_IP=10
CUSTOMER_PASSWORD_OTP_TTL_MS=300000
CUSTOMER_PASSWORD_OTP_MAX_ATTEMPTS=5
CUSTOMER_PASSWORD_OTP_MAX_PER_PHONE=3
CUSTOMER_PASSWORD_OTP_MAX_PER_IP=10
CUSTOMER_PASSWORD_OTP_RESEND_COOLDOWN_MS=60000
CUSTOMER_REAUTH_TOKEN_TTL_MS=600000

RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/storefront/auth/google/callback
STOREFRONT_COOKIE_SECURE=false
STOREFRONT_COOKIE_SAMESITE=lax
STOREFRONT_COOKIE_DOMAIN=

DEFAULT_USER_TEMP_PASSWORD=__set_local_temp_password__
STOREFRONT_GENERIC_CUSTOMER_PASSWORD=__set_storefront_customer_password__
RUN_PRISMA_SEED_ON_BOOT=false
ENABLE_DEMO_SEED=false
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Local Admin
SEED_SUPERADMIN_FIRST_NAME=
SEED_SUPERADMIN_LAST_NAME=
SEED_USER_PASSWORD=

PRISMA_APPLY_MIGRATIONS=true
PRISMA_QUERY_TIMEOUT_MS=20000
PARAMETRIC_IMPORT_TIMEOUT_MS=120000
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

EMAIL_PROVIDER=DEV
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_ALLOW_INVALID_CERTS=false
EMAIL_FROM_DEFAULT=no-reply@example.com
EMAIL_FROM_NAME_DEFAULT=Sistema Administrativo

INBOX_EMAIL_IMAP_HOST=
INBOX_EMAIL_IMAP_PORT=
INBOX_EMAIL_IMAP_SECURITY=
INBOX_EMAIL_SMTP_HOST=
INBOX_EMAIL_SMTP_PORT=
INBOX_EMAIL_SMTP_SECURITY=
INBOX_EMAIL_USER=
INBOX_EMAIL_PASSWORD=
INBOX_EMAIL_DEFAULT_FROM=
INBOX_EMAIL_DEFAULT_NAME=
INBOX_EMAIL_DISPLAY_NAME=
INBOX_EMAIL_MAX_ATTACHMENT_MB=
INBOX_EMAIL_RATE_PER_MINUTE=
INBOX_EMAIL_POLL_INTERVAL_MS=
INBOX_EMAIL_POLL_BATCH_SIZE=

PAYMENTS_PROVIDER=mercadopago
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_COUNTRY=AR
MP_INTEGRATOR_ID=
MP_APPLICATION_ID=
MP_TIMEOUT_MS=12000

CONFIG_ENCRYPTION_KEY=local-dev-config-encryption-key-change-me
GOOGLE_OAUTH_ENABLED=true
ADMIN_RECAPTCHA_ENABLED=false
ADMIN_RECAPTCHA_SITE_KEY=
