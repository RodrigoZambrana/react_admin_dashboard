# URL público consumido por el navegador (ajusta si expones un proxy distinto)
NEXT_PUBLIC_STOREFRONT_API_URL=http://localhost:4000/api/storefront
# URL interno que usará Next.js en SSR dentro del contenedor
STOREFRONT_API_URL=http://backend:4000/api/storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_HOME_PATH=/

# Feature flags
NEXT_PUBLIC_GOOGLE_BUTTON_ENABLED=true
NEXT_PUBLIC_ENABLE_STOREFRONT_MOCKS=false
ENABLE_STOREFRONT_MOCKS=false

# Localización y formato
NEXT_PUBLIC_STORE_LOCALE=es-UY

# Mercado Pago
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-REPLACE-ME
NEXT_PUBLIC_MP_COUNTRY=UY
NEXT_PUBLIC_MP_SUCCESS_URL=/payment/success
NEXT_PUBLIC_MP_FAILURE_URL=/payment/error
