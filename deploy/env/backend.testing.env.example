NODE_ENV=production
PORT=3000
# Cambia a "core" para ejecutar la variante general durante pruebas
CLIENT_SLUG=urucortinas

DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/react_admin_dashboard?schema=public
ALLOWED_ORIGINS=https://testing.example.com

JWT_SECRET=
COOKIE_SECRET=
SESSION_TTL_HOURS=168

RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=

DEFAULT_USER_TEMP_PASSWORD=TempPass@123!
RUN_PRISMA_SEED_ON_BOOT=false
ENABLE_DEMO_SEED=false

SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Testing Admin
SEED_SUPERADMIN_FIRST_NAME=
SEED_SUPERADMIN_LAST_NAME=
SEED_USER_PASSWORD=

PRISMA_APPLY_MIGRATIONS=true
SENTRY_DSN=
