# Frontend (RUN_AND_BUILD_TIME)
BACKEND_HOST=backend
BACKEND_PORT=3000
VITE_APP_NAME=React Admin Dashboard
VITE_API_URL=http://backend:3000/api
VITE_STATE_SIGNATURE_KEY=__replace_with_unique_secret__
VITE_RECAPTCHA_ENABLED=false
VITE_RECAPTCHA_SITE_KEY=

# Backend (RUN_TIME)
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://your-frontend-domain.example.com
PRISMA_APPLY_MIGRATIONS=true
RUN_PRISMA_SEED_ON_BOOT=false
ENABLE_DEMO_SEED=false
SESSION_TTL_HOURS=168
DATABASE_URL=postgresql://user:pass@db-host:5432/react_admin_dashboard?schema=public
JWT_SECRET=__replace_with_unique_secret__
COOKIE_SECRET=__replace_with_unique_secret__
DEFAULT_USER_TEMP_PASSWORD=TempPass@123!
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=Admin@123!
SEED_SUPERADMIN_NAME=Prod Admin
SEED_SUPERADMIN_FIRST_NAME=
SEED_SUPERADMIN_LAST_NAME=
SEED_USER_PASSWORD=TempPass@123!
RECAPTCHA_SECRET_KEY=
SENTRY_DSN=
