# Frontend (RUN_AND_BUILD_TIME)
BACKEND_HOST=react-admin-dashboard-backend
BACKEND_PORT=3000
VITE_APP_NAME=Sistema Administrativo
VITE_API_URL=/api
VITE_STATE_SIGNATURE_KEY=__replace_with_unique_secret__
VITE_RECAPTCHA_ENABLED=false
VITE_RECAPTCHA_SITE_KEY=

# Backend (RUN_TIME)
NODE_ENV=production
PORT=3000
CLIENT_SLUG=core
DEFAULT_ALLOWED_ORIGINS=https://your-frontend-domain.example.com
ALLOWED_ORIGINS=https://your-frontend-domain.example.com
NEXT_PUBLIC_SITE_URL=https://your-frontend-domain.example.com
PRISMA_APPLY_MIGRATIONS=true
RUN_PRISMA_SEED_ON_BOOT=false
ENABLE_DEMO_SEED=false
SESSION_TTL_HOURS=168
DATABASE_URL=postgresql://user:pass@db-host:5432/react_admin_dashboard?schema=public
JWT_SECRET=__replace_with_unique_secret__
COOKIE_SECRET=__replace_with_unique_secret__
DEFAULT_USER_TEMP_PASSWORD=__set_if_manual_user_creation_is_used__
STOREFRONT_GENERIC_CUSTOMER_PASSWORD=__set_storefront_customer_password__
SEED_SUPERADMIN_EMAIL=__set_if_seed_bootstrap_is_enabled__
SEED_SUPERADMIN_PASSWORD=__set_if_seed_bootstrap_is_enabled__
SEED_SUPERADMIN_NAME=Prod Admin
SEED_SUPERADMIN_FIRST_NAME=
SEED_SUPERADMIN_LAST_NAME=
SEED_USER_PASSWORD=__set_if_seed_bootstrap_is_enabled__
SENTRY_DSN=
INBOX_EMAIL_IMAP_HOST=
INBOX_EMAIL_IMAP_PORT=
INBOX_EMAIL_IMAP_SECURITY=
INBOX_EMAIL_SMTP_HOST=
INBOX_EMAIL_SMTP_PORT=
INBOX_EMAIL_SMTP_SECURITY=
INBOX_EMAIL_USER=
INBOX_EMAIL_PASSWORD=
INBOX_EMAIL_DEFAULT_FROM=
INBOX_EMAIL_DEFAULT_NAME=
INBOX_EMAIL_DISPLAY_NAME=
INBOX_EMAIL_MAX_ATTACHMENT_MB=
INBOX_EMAIL_RATE_PER_MINUTE=
INBOX_EMAIL_POLL_INTERVAL_MS=
INBOX_EMAIL_POLL_BATCH_SIZE=
PAYMENTS_PROVIDER=mercadopago
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_COUNTRY=AR
MP_TIMEOUT_MS=12000
CONFIG_ENCRYPTION_KEY=
GOOGLE_OAUTH_ENABLED=true
ADMIN_RECAPTCHA_ENABLED=false
ADMIN_RECAPTCHA_SITE_KEY=
STOREFRONT_RECAPTCHA_ENABLED=false
STOREFRONT_RECAPTCHA_SITE_KEY=
